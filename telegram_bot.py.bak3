        "💬 對話\n"
        "直接傳訊息 → AI 回覆\n\n"
        "🔄 模式切換\n/mode → 切換模式（對話/自主開發/教學/資料庫/終端/桌面）\n\n💻 開發（需先切換到自主開發模式）\n"
        "/dev [需求] → 生成程式碼並預覽\n"
        "/confirm → 確認寫入\n"
        "/cancel → 取消\n"
        "/history → 開發歷史\n"
        "/ls → 列出所有 .py 檔案\n"
        "/read [檔名] → 查看程式碼\n"
        "/restore [檔名] → 還原備份\n\n"
        "🤖 Claude 學習\n"
        "/claude [問題] → 讓 Claude 學習該主題\n"
        "/claude_stop → 停止 Claude 對話\n"
        "/knowledge → Claude 知識庫統計\n\n"
        "💬 ChatGPT 學習\n"
        "/chatgpt [問題] → 讓 ChatGPT 學習該主題\n"
        "/chatgpt_stop → 停止 ChatGPT 對話\n"
        "/gpt_knowledge → ChatGPT 知識庫統計\n\n"
        "🔧 系統\n"
        "/status → 系統狀態\n"
        "/memory → 記憶庫\n"
        "/id → 你的 Chat ID"
    )

@bot.message_handler(commands=["id"])
def cmd_id(message):
    bot.reply_to(message, f"你的 Chat ID：`{message.chat.id}`")

@bot.message_handler(commands=["status"])
def cmd_status(message):
    if not _is_allowed(message): return

    # ── Ollama 本機 ──
    try:
        import requests as req
        r = req.get("http://localhost:11434/api/tags", timeout=3)
        models = [m["name"] for m in r.json().get("models", [])]
        ollama_local = f"✅ 在線  模型：{', '.join(models[:3])}"
    except Exception:
        ollama_local = "❌ 離線"

    # ── AB 節點連線狀態 ──
    nodes_text = ""
    try:
        from ollama_guard import get_nodes_status, _should_use_distributed
        ns = get_nodes_status()          # 回傳 dict，key 為節點名稱
        lines = []
        for name, info in ns.items():
            ok      = info.get("online", False)
            latency = info.get("latency_ms")
            icon    = "✅" if ok else "❌"
            lat_str = f"  {latency:.0f}ms" if (ok and latency is not None) else ""
            lines.append(f"  {icon} {name}{lat_str}")
        nodes_text = "\n".join(lines) if lines else "  （無節點資訊）"

        # 分散式推論是否啟用
        dist_ok = _should_use_distributed()
        dist_str = "✅ 分散式推論啟用中" if dist_ok else "⚪ 單機模式"
    except Exception as e:
        nodes_text = f"  （無法讀取：{e}）"
        dist_str   = ""

    # ── 記憶庫 ──
    try:
        from long_term_memory import get_memory
        mem_count = len(get_memory()._memories)
    except Exception:
        mem_count = "?"

    # ── 開發引擎狀態 ──
    try:
        from self_dev_engine import get_engine
        eng = get_engine()
        if eng.is_in_fix_loop():
            dev_str = "🔧 修正循環進行中"
        elif eng.has_pending():
            dev_str = "⏳ 等待確認"
        else:
            dev_str = "⚪ 待機"
    except Exception:
        dev_str = "?"

    bot.reply_to(message,
        f"🦞 立 AI 系統狀態\n"
        f"{'─'*28}\n"
        f"🖥 本機 Ollama：{ollama_local}\n\n"
        f"🔗 AB 節點：\n{nodes_text}\n"
        f"{dist_str}\n\n"
        f"💾 記憶庫：{mem_count} 筆\n"
        f"🛠 開發引擎：{dev_str}\n"
        f"🕐 {datetime.datetime.now().strftime('%H:%M:%S')}"
    )

@bot.message_handler(commands=["memory"])
def cmd_memory(message):
    if not _is_allowed(message): return
    try:
        from long_term_memory import get_memory
        mem = get_memory()
        items = sorted(mem._memories, key=lambda m: m["accessed_at"], reverse=True)[:8]
        if not items:
            bot.reply_to(message, "記憶庫是空的")
            return
        lines = ["🧠 最近記憶：\n"]
        for m in items:
            stars = "★" * min(m.get("importance", 5), 5)
            lines.append(f"{stars} {m['content'][:60]}")
        bot.reply_to(message, "\n".join(lines))
    except Exception as e:
        bot.reply_to(message, f"讀取失敗：{e}")

@bot.message_handler(commands=["dev"])
def cmd_dev(message):
    if not _is_allowed(message): return
    cid = message.chat.id
    if _get_mode(cid) != "dev":
        bot.reply_to(message, "⚠️ 請先切換到自主開發模式\n輸入 /mode 選擇模式")
        return
    parts = message.text.split(" ", 1)
    if len(parts) < 2:
        bot.reply_to(message, "用法：/dev [需求]\n例如：/dev 修改 reflex_engine.py 讓問候更自然")
        return
    request = parts[1].strip()
    # 儲存需求，讓使用者選擇開發模式
    _dev_pending_requests[message.chat.id] = request
    from telebot.types import InlineKeyboardMarkup, InlineKeyboardButton
    kb = InlineKeyboardMarkup(row_width=1)
    kb.add(
        InlineKeyboardButton("🤝 與 Claude 共同開發", callback_data="devmode_claude"),
        InlineKeyboardButton("🦾 立AI 自己開發",      callback_data="devmode_solo"),
    )
    bot.reply_to(message,
        f"📋 需求：{request[:100]}\n\n請選擇開發模式：",
        reply_markup=kb
    )

# 儲存待處理的開發需求
_dev_pending_requests: dict = {}

@bot.callback_query_handler(func=lambda call: call.data.startswith("devmode_"))
def on_devmode_callback(call):
    cid  = call.message.chat.id
    mode = call.data.replace("devmode_", "")
    request = _dev_pending_requests.pop(cid, "")
    if not request:
        bot.answer_callback_query(call.id, "需求已過期，請重新輸入")
        return
    bot.answer_callback_query(call.id, "⏳ 開始處理...")
    try:
        bot.edit_message_reply_markup(cid, call.message.message_id, reply_markup=None)
    except Exception:
        pass
    if mode == "solo":
        bot.send_message(cid, "🦾 立AI自己開發模式，從知識庫找經驗...")
        try:
            from self_dev_engine import get_engine, _plan_state
            from claude_knowledge import get_knowledge
            results = get_knowledge().search(request, top_k=5)
            if results:
                lines = ["相關開發經驗："]
                for r in results:
                    lines.append(f"• {r.get('question','')[:60]}")
                    lines.append(f"  {r.get('answer','')[:100]}")
                exp_context = "\n".join(lines)
                _plan_state["_solo_context"] = exp_context
                bot.send_message(cid, f"找到 {len(results)} 筆相關經驗，開始生成...")
            else:
                _plan_state["_solo_context"] = "（無相關經驗，用本地模型直接生成）"
                bot.send_message(cid, "知識庫無相關經驗，用本地模型直接生成...")
            result = get_engine().handle(request)
            bot.send_message(cid, result)
        except Exception as e:
            bot.send_message(cid, f"❌ 錯誤：{e}")
    else:
        bot.send_message(cid, "🤝 與 Claude 共同開發模式...")
        try:
            from self_dev_engine import get_engine, _plan_state
            _plan_state.pop("_solo_context", None)
            result = get_engine().handle(request)
            bot.send_message(cid, result)
        except Exception as e:
            bot.send_message(cid, f"❌ 錯誤：{e}")

@bot.message_handler(commands=["mode"])
def cmd_mode(message):
    if not _is_allowed(message): return
    from telebot.types import InlineKeyboardMarkup, InlineKeyboardButton
    cid = message.chat.id
    cur = _get_mode(cid)
    mode_names = {
        "chat":     "💬 對話",
        "dev":      "🤖 自主開發",
        "teach":    "📚 教學",
        "database": "🗄 資料庫",
        "terminal": "⌨️ 終端",
        "desktop":  "🖥 桌面",
    }
    kb = InlineKeyboardMarkup(row_width=2)
    for mode_id, label in mode_names.items():
        kb.add(InlineKeyboardButton(
            f"{'✅ ' if mode_id == cur else ''}{label}",
            callback_data=f"setmode_{mode_id}"
        ))
    bot.reply_to(message,
        f"目前模式：{mode_names.get(cur, cur)}\n\n請選擇模式：",
        reply_markup=kb
    )

@bot.callback_query_handler(func=lambda call: call.data.startswith("setmode_"))
def on_setmode(call):
    cid  = call.message.chat.id
    mode = call.data.replace("setmode_", "")
    _set_mode(cid, mode)
    mode_names = {
        "chat": "💬 對話", "dev": "🤖 自主開發",
        "teach": "📚 教學", "database": "🗄 資料庫",
        "terminal": "⌨️ 終端", "desktop": "🖥 桌面",
    }
    bot.answer_callback_query(call.id, f"已切換到 {mode_names.get(mode, mode)}")
    try:
        bot.edit_message_text(
            f"✅ 已切換到 {mode_names.get(mode, mode)}",
            chat_id=cid, message_id=call.message.message_id
        )
    except Exception:
        pass

@bot.message_handler(commands=["confirm"])
def cmd_confirm(message):
