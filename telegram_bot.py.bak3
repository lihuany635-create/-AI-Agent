@bot.message_handler(commands=["gpt_knowledge"])
def cmd_gpt_knowledge(message):
    """查看 ChatGPT 知識庫統計"""
    if not _is_allowed(message): return
    try:
        from chatgpt_knowledge import get_knowledge
        stats = get_knowledge().get_stats()
        bot.reply_to(message, stats)
    except Exception as e:
        bot.reply_to(message, f"❌ 讀取失敗：{e}")


@bot.message_handler(commands=["analyze"])
def cmd_analyze(message):
    """分析指定模組，用法：/analyze telegram_bot.py"""
    if not _is_allowed(message): return
    parts = message.text.split(" ", 1)
    if len(parts) < 2:
        bot.reply_to(message, "用法：/analyze 檔名.py\n例如：/analyze telegram_bot.py self_dev_engine.py")
        return
    fname = parts[1].strip()
    bot.reply_to(message, f"⏳ 分析中：{fname}")
    try:
        import subprocess, pathlib
        result = subprocess.run(
            ["python", "analyze_module.py"] + fname.split(),
            capture_output=True, text=True, timeout=15,
            encoding="utf-8", errors="ignore",
            cwd=str(pathlib.Path(__file__).parent)
        )
        output = result.stdout or result.stderr or "（無輸出）"
        if len(output) > 4000:
            output = output[:4000] + "\n...（已截斷）"
        bot.reply_to(message, output)
    except Exception as e:
        bot.reply_to(message, f"❌ 分析失敗：{e}")


# ── Inline Button Callback（按鈕確認/取消）────────────────────────────────────

def _make_fix_keyboard():
    """修正循環中的按鈕：確認 / 退回 / 停"""
    from telebot.types import InlineKeyboardMarkup, InlineKeyboardButton
    kb = InlineKeyboardMarkup()
    kb.row(
        InlineKeyboardButton("✅ 確認修正", callback_data="dev_confirm"),
        InlineKeyboardButton("⏪ 退回上一步", callback_data="dev_rollback"),
    )
    kb.row(
        InlineKeyboardButton("🛑 停止修正", callback_data="dev_stop"),
    )
    return kb

def _make_confirm_keyboard():
    """一般開發確認按鈕：確認 / 取消"""
    from telebot.types import InlineKeyboardMarkup, InlineKeyboardButton
    kb = InlineKeyboardMarkup()
    kb.row(
        InlineKeyboardButton("✅ 確認", callback_data="dev_confirm"),
        InlineKeyboardButton("❌ 取消", callback_data="dev_cancel"),
    )
    return kb

def _send_result_with_buttons(cid: int, result: str, eng):
    """
    傳送結果訊息：
    - 若仍在修正循環中 → 附上修正循環按鈕（確認/退回/停）
    - 若有 pending（一般確認）→ 附上一般按鈕
    - 否則純文字
    """
    text = result[:4000]
    try:
        if eng.is_in_fix_loop():
            bot.send_message(cid, text, reply_markup=_make_fix_keyboard())
        elif eng.has_pending():
            bot.send_message(cid, text, reply_markup=_make_confirm_keyboard())
        else:
            bot.send_message(cid, text)
    except Exception:
        bot.send_message(cid, text)

@bot.callback_query_handler(func=lambda call: True)
def callback_dev_action(call):
    """處理手機按下確認/退回/停 按鈕"""
    logger.info(f"[Bot] callback 收到：{call.data}")
    cid = call.message.chat.id

    # ── mode_* 模式切換 ───────────────────────────────────────────────────────
    if call.data.startswith("mode_"):
        mode_id = call.data.replace("mode_", "")
        _set_mode(cid, mode_id)
        mode_names = {
            "chat": "💬 對話模式", "terminal": "⌨️ 終端模式",
            "dev": "🤖 自主開發模式", "teach": "📚 教學模式",
            "database": "🗄 資料庫模式", "desktop": "🖥 桌面模式",
        }
        bot.answer_callback_query(call.id, mode_names.get(mode_id, mode_id))
        try:
            bot.edit_message_reply_markup(cid, call.message.message_id, reply_markup=None)
        except Exception:
            pass
        bot.send_message(cid, f"已切換到 {mode_names.get(mode_id, mode_id)}")
        return

    # ── show_modes ─────────────────────────────────────────────────────────────
    if call.data == "show_modes":
        bot.answer_callback_query(call.id, "")
        from telebot.types import InlineKeyboardMarkup, InlineKeyboardButton
        kb = InlineKeyboardMarkup(row_width=2)
        kb.add(
            InlineKeyboardButton("💬 對話",    callback_data="mode_chat"),
            InlineKeyboardButton("⌨️ 終端",    callback_data="mode_terminal"),
            InlineKeyboardButton("🤖 自主開發", callback_data="mode_dev"),
            InlineKeyboardButton("📚 教學",    callback_data="mode_teach"),
            InlineKeyboardButton("🗄 資料庫",  callback_data="mode_database"),
            InlineKeyboardButton("🖥 桌面",    callback_data="mode_desktop"),
        )
        bot.send_message(cid, "請選擇模式：", reply_markup=kb)
        return

    # ── dt_* dev_tool callback ─────────────────────────────────────────────────
    if call.data.startswith("dt_"):
        bot.answer_callback_query(call.id, "⏳ 處理中...")
        try:
            from dev_tool import get_tool
            handled = get_tool().handle_callback(call.data)
            if not handled:
                bot.send_message(cid, f"❌ 未知指令：{call.data}")
        except Exception as e:
            bot.send_message(cid, f"❌ 執行失敗：{e}")
        try:
            bot.edit_message_reply_markup(cid, call.message.message_id, reply_markup=None)
        except Exception:
            pass
        return

    # ── devmode_* ──────────────────────────────────────────────────────────────
    if call.data.startswith("devmode_"):
        mode = call.data.replace("devmode_", "")
        try:
            bot.edit_message_reply_markup(cid, call.message.message_id, reply_markup=None)
        except Exception:
            pass
        if mode == "solo":
            bot.answer_callback_query(call.id, "🦾 立AI自己開發")
            bot.send_message(cid, "🦾 立AI自己開發模式\n\n請直接輸入需求：")
        else:
            bot.answer_callback_query(call.id, "🤝 與Claude共同開發")
            bot.send_message(cid, "🤝 與 Claude 共同開發模式\n\n請直接輸入需求：")
        return

    # ── mem_* ──────────────────────────────────────────────────────────────────
    if call.data.startswith("mem_"):
        if call.data == "mem_save":
            bot.answer_callback_query(call.id, "已存入記憶")
            bot.edit_message_text("已存入記憶", chat_id=cid, message_id=call.message.message_id)
        elif call.data == "mem_skip":
            bot.answer_callback_query(call.id, "已跳過")
            bot.edit_message_text("已跳過", chat_id=cid, message_id=call.message.message_id)
        return

    # ── act_* 功能按鈕 ─────────────────────────────────────────────────────────
    if call.data.startswith("act_"):
        import threading, subprocess
        bot.answer_callback_query(call.id, "⏳ 執行中...")
        act = call.data

        if act == "act_memory":
            try:
                from long_term_memory import get_memory
                items = sorted(get_memory()._memories, key=lambda m: m["accessed_at"], reverse=True)[:8]
                lines = ["🧠 最近記憶：\n"] + [f"★ {m['content'][:60]}" for m in items]
                bot.send_message(cid, "\n".join(lines))
            except Exception as e:
                bot.send_message(cid, f"❌ {e}")
        elif act == "act_capabilities":
            bot.send_message(cid,
                "⚡ 立 AI 能力：\n\n💬 對話：自然語言對話、記憶學習\n"
                "⌨️ 終端：執行系統指令\n🤖 開發：自主生成程式碼\n"
                "📚 教學：存入記憶庫\n🖥 桌面：截圖、視窗控制\n"
                "🌐 YouTube：摘要字幕\n🤝 Claude/ChatGPT：橋接學習"
            )
        elif act == "act_ck_stats":
            try:
                from claude_knowledge import get_knowledge
                bot.send_message(cid, get_knowledge().get_stats())
            except Exception as e:
                bot.send_message(cid, f"❌ {e}")
        elif act == "act_gpt_knowledge":
            try:
                from chatgpt_knowledge import get_knowledge
                bot.send_message(cid, get_knowledge().get_stats())
            except Exception as e:
                bot.send_message(cid, f"❌ {e}")
        elif act == "act_repair":
            def _repair():
                try:
                    result = subprocess.run(
                        ["python", "-c", "from repair_engine import RepairEngine; r=RepairEngine(); print(r.run_diagnosis())"],
                        capture_output=True, text=True, timeout=30, encoding="utf-8", errors="ignore"
                    )
                    bot.send_message(cid, result.stdout[:4000] or "完成")
                except Exception as e:
                    bot.send_message(cid, f"❌ {e}")
            threading.Thread(target=_repair, daemon=True).start()
        elif act == "act_screenshot":
            def _ss():
                try:
                    result = subprocess.run(
                        ["python", "-c",
                         "import pyautogui, datetime, pathlib; "
                         "p=pathlib.Path('memory/screenshots'); p.mkdir(exist_ok=True); "
                         "f=p/f'ss_{datetime.datetime.now().strftime(\"%H%M%S\")}.png'; "
                         "pyautogui.screenshot(str(f)); print('截圖：'+str(f))"],
                        capture_output=True, text=True, timeout=15, encoding="utf-8", errors="ignore"
                    )
                    bot.send_message(cid, result.stdout or "截圖完成")
                except Exception as e:
                    bot.send_message(cid, f"❌ {e}")
            threading.Thread(target=_ss, daemon=True).start()
        elif act == "act_list_windows":
            try:
                import pygetwindow as gw
                wins = [w.title for w in gw.getAllWindows() if w.title][:15]
                bot.send_message(cid, "🪟 目前視窗：\n" + "\n".join(wins))
            except Exception as e:
                bot.send_message(cid, f"❌ {e}")
        elif act == "act_ls_desktop":
            try:
                import pathlib
                desktop = pathlib.Path.home() / "OneDrive" / "桌面"
                if not desktop.exists():
                    desktop = pathlib.Path.home() / "Desktop"
                files = [f.name for f in desktop.iterdir()][:20]
                bot.send_message(cid, "📁 桌面：\n" + "\n".join(files))
            except Exception as e:
                bot.send_message(cid, f"❌ {e}")
        elif act == "act_sysinfo":
            try:
                import psutil
                cpu = psutil.cpu_percent(interval=1)
                mem = psutil.virtual_memory()
                disk = psutil.disk_usage("/")
                bot.send_message(cid,
                    f"💻 系統資訊\nCPU：{cpu}%\n"
                    f"記憶體：{mem.percent}% ({mem.used//1024//1024}MB/{mem.total//1024//1024}MB)\n"
                    f"磁碟：{disk.percent}%"
                )
            except Exception as e:
                bot.send_message(cid, f"❌ {e}")
        elif act == "act_dev_history":
            try:
                import json, pathlib
                hf = pathlib.Path("memory/dev_history.json")
                if hf.exists():
                    history = json.loads(hf.read_text(encoding="utf-8"))
                    lines = ["💻 最近開發歷史：\n"] + [f"✓ {h.get('file','?')} — {h.get('goal','?')[:40]}" for h in history[-5:]]
                    bot.send_message(cid, "\n".join(lines))
                else:
                    bot.send_message(cid, "尚無開發歷史")
            except Exception as e:
                bot.send_message(cid, f"❌ {e}")
        elif act == "act_logs":
            try:
                import pathlib
                log_file = pathlib.Path("memory/agent.log")
                if log_file.exists():
                    lines = log_file.read_text(encoding="utf-8", errors="ignore").splitlines()
                    bot.send_message(cid, "\n".join(lines[-30:])[:4000])
                else:
                    bot.send_message(cid, "找不到日誌檔案")
            except Exception as e:
                bot.send_message(cid, f"❌ {e}")
        elif act in ("act_ask_claude", "act_ask_chatgpt", "act_analyze", "act_module_explain", "act_add_knowledge"):
            prompts = {
                "act_ask_claude": "請輸入要問 Claude 的問題：",
                "act_ask_chatgpt": "請輸入要問 ChatGPT 的問題：",
                "act_analyze": "請輸入要分析的檔名（如：telegram_bot.py）：",
                "act_module_explain": "請輸入要查詢的檔名（如：desktop_agent.py）：",
                "act_add_knowledge": "請輸入要存入知識庫的內容：",
            }
            bot.send_message(cid, prompts[act])
        return

    VALID = {"dev_confirm", "dev_cancel", "dev_rollback", "dev_stop", "dev_back_models"}
    if call.data not in VALID and not call.data.startswith("dev_model_") and not call.data.startswith("dev_start_"):
        bot.answer_callback_query(call.id, "")
        return

    if ALLOWED and cid not in ALLOWED:
        bot.answer_callback_query(call.id, "❌ 未授權")
        return

    # 先清掉原訊息的按鈕（無論結果）
    try:
        bot.edit_message_reply_markup(
            cid, call.message.message_id, reply_markup=None
        )
    except Exception:
        pass

    from self_dev_engine import get_engine
    eng = get_engine()

    # 第一層：選分組 → 推送第二層步驟
    if call.data.startswith("dev_model_"):
        model_key = call.data.replace("dev_model_", "")
        bot.answer_callback_query(call.id, "載入步驟...")
        try:
            from self_dev_engine import _push_model_steps_to_phone
            _push_model_steps_to_phone(model_key)
        except Exception as e:
            bot.send_message(cid, f"❌ 載入步驟失敗：{e}")
        return

    # 返回第一層
    if call.data == "dev_back_models":
        bot.answer_callback_query(call.id, "返回分組選擇")
        try:
            from self_dev_engine import _model_step_map, _push_mindmap_to_phone
            req   = _model_step_map.get("request", "")
            steps = _model_step_map.get("steps", [])
            _push_mindmap_to_phone(req, "", steps)
        except Exception as e:
            bot.send_message(cid, f"❌ 返回失敗：{e}")
        return

    # 第二層：選步驟 → 確認開始製作
    if call.data.startswith("dev_start_"):
        try:
            step_idx = int(call.data.replace("dev_start_", ""))
            from self_dev_engine import _plan_state
            if _plan_state["active"]:
                _plan_state["current_step"] = step_idx
                _plan_state["pending_write"] = {}
                step = _plan_state["steps"][step_idx]
                bot.answer_callback_query(call.id, f"步驟 {step_idx+1}")
                from telebot.types import InlineKeyboardMarkup, InlineKeyboardButton
                kb = InlineKeyboardMarkup()
                kb.row(
                    InlineKeyboardButton("✅ 確認開始製作", callback_data="dev_confirm"),
                    InlineKeyboardButton("⬅️ 返回", callback_data="dev_back_models"),
                )
                bot.send_message(cid,
                    f"▶️ 步驟 {step_idx+1}：{step['title']}\n"
                    f"   📄 {step['file']}\n\n"
                    f"{step.get('desc','')[:150]}\n\n"
                    f"確認開始製作這個步驟？",
                    reply_markup=kb
                )
            else:
                bot.answer_callback_query(call.id, "沒有進行中的計畫")
        except Exception as e:
            bot.send_message(cid, f"❌ 跳步失敗：{e}")
        return

    if call.data == "dev_confirm":
        bot.answer_callback_query(call.id, "⏳ 執行中...")
        try:
            if not eng.has_pending():
                bot.send_message(cid, "沒有待確認的行動")
                return
            bot.send_message(cid, "⏳ 執行中，請稍候...")
            result = eng.confirm()
            _send_result_with_buttons(cid, result, eng)
        except Exception as e:
            logger.error(f"[Bot] callback confirm 失敗：{e}")
            bot.send_message(cid, f"❌ 執行失敗：{e}")

    elif call.data == "dev_cancel":
        bot.answer_callback_query(call.id, "已取消")
        try:
            result = eng.cancel()
            bot.send_message(cid, result)
        except Exception as e:
            bot.send_message(cid, f"❌ 取消失敗：{e}")

    elif call.data == "dev_rollback":
        bot.answer_callback_query(call.id, "⏪ 退回上一步...")
        try:
            result = eng.rollback_step()
            # 退回後仍有 pending，附上一般確認按鈕
            _send_result_with_buttons(cid, result, eng)
        except Exception as e:
            bot.send_message(cid, f"❌ 退回失敗：{e}")

    elif call.data == "dev_stop":
        bot.answer_callback_query(call.id, "🛑 停止修正循環")
        try:
            result = eng.stop_fix()
            bot.send_message(cid, result)
        except Exception as e:
            bot.send_message(cid, f"❌ 停止失敗：{e}")


# ── 一般訊息（傳給 AI 處理）─────────────────────────────────────────────────

@bot.message_handler(func=lambda m: True)
def handle_message(message):
    if not _is_allowed(message):
        bot.reply_to(message, "❌ 未授權的使用者")
        return

    text = message.text.strip()
    logger.info(f"[Bot] 收到訊息：{text[:50]}")

    # 發送「思考中」狀態
    bot.send_chat_action(message.chat.id, "typing")

    # 確認/取消快速攔截
    if text in ["確認", "好", "執行", "yes", "ok"]:
        try:
            from self_dev_engine import get_engine
            eng = get_engine()
            if eng.has_pending():
                bot.reply_to(message, "⏳ 執行中...")
                result = eng.confirm()
                _send_result_with_buttons(message.chat.id, result, eng)
                return
        except Exception:
            pass

    if text in ["取消", "不", "算了", "cancel"]:
        try:
            from self_dev_engine import get_engine
            eng = get_engine()
            if eng.has_pending():
                result = eng.cancel()
                bot.reply_to(message, result)
                return
        except Exception:
            pass

    if text in ["停", "停止", "stop"]:
        try:
            from self_dev_engine import get_engine
            eng = get_engine()
            if eng.is_in_fix_loop():
                result = eng.stop_fix()
                bot.reply_to(message, result)
                return
            elif eng.has_pending():
                result = eng.cancel()
                bot.reply_to(message, result)
                return
        except Exception:
            pass

    if text in ["退回", "上一步", "rollback"]:
        try:
            from self_dev_engine import get_engine
            eng = get_engine()
            if eng.has_pending():
                result = eng.rollback_step()
                _send_result_with_buttons(message.chat.id, result, eng)
                return
        except Exception:
            pass

    # 開發需求直接觸發（不需要加 /dev 前綴）
    try:
        from self_dev_engine import get_engine
        from Lobster_Core import LobsterCore
        import re
        dev_keywords = ["修改", "新增", "幫我改", "幫我加", "幫我在", "改一下", "加上", "加入", "建立", "新建", "寫一個"]
        has_py = bool(re.search(r"\w+\.py", text))
        has_kw = any(kw in text for kw in dev_keywords)
        if has_py and has_kw and _get_mode(message.chat.id) == "dev":
            bot.send_chat_action(message.chat.id, "typing")
            _dev_pending_requests[message.chat.id] = text
            from telebot.types import InlineKeyboardMarkup, InlineKeyboardButton
            kb = InlineKeyboardMarkup(row_width=1)
            kb.add(
                InlineKeyboardButton("🤝 與 Claude 共同開發", callback_data="devmode_claude"),
                InlineKeyboardButton("🦾 立AI 自己開發",      callback_data="devmode_solo"),
            )
            bot.reply_to(message,
                f"📋 需求：{text[:100]}\n\n請選擇開發模式：",
                reply_markup=kb
            )
            return
    except Exception:
        pass

    # 傳給 AI
    reply = _ask_ai(text, chat_id=message.chat.id)
    if not reply:
        reply = "（沒有回應）"

    # Telegram 訊息長度限制 4096 字
    if len(reply) > 4000:
        reply = reply[:4000] + "\n...（訊息過長已截斷）"

    bot.reply_to(message, reply)

    # 更新對話上下文
    try:
        from cognition_state_manager import update_context
        update_context(text, reply)
    except Exception:
        pass

    # 寫入共享訊息檔，桌面視窗會自動讀取顯示
    try:
        import json, pathlib, datetime
        msg_file = pathlib.Path("memory/mobile_messages.json")
        msg_file.parent.mkdir(exist_ok=True)
        msgs = []
        if msg_file.exists():
            try: msgs = json.loads(msg_file.read_text(encoding="utf-8"))
            except: msgs = []
        msgs.append({
            "time":  datetime.datetime.now().strftime("%H:%M:%S"),
            "user":  text,
            "reply": reply,
        })
        msgs = msgs[-50:]  # 最多保留 50 筆
        msg_file.write_text(json.dumps(msgs, ensure_ascii=False), encoding="utf-8")
    except Exception:
        pass


# ── 推送通知函式（供其他模組呼叫）──────────────────────────────────────────

def push(message_text: str):
    """
    從任何地方主動推送訊息到手機
    用法：from telegram_bot import push; push("修復完成！")
    """
    if not ALLOWED:
        logger.warning("[Bot] 無法推送：ALLOWED_CHAT_IDS 未設定")
        return
    for chat_id in ALLOWED:
        try:
            bot.send_message(chat_id, f"🔔 {message_text}")
            logger.info(f"[Bot] 推送成功 → {chat_id}")
        except Exception as e:
            logger.error(f"[Bot] 推送失敗：{e}")


# ── 啟動 ─────────────────────────────────────────────────────────────────────

def start_bot(background: bool = False):
    """啟動 Bot（可背景執行，收到訊息才啟動 AI 核心）"""
    logger.info("Telegram Bot 啟動中...")
    print("Telegram Bot 已啟動（輕量待機模式）")
    print("   AI 核心將在收到第一則訊息時自動啟動")
    print("   在 Telegram 傳訊息給你的 Bot 即可")

    # 推送 Bot 上線通知（不啟動 AI 核心，很快）
    push("🤖 Bot 已上線，傳訊息給我就會自動啟動 AI")

    if background:
        t = threading.Thread(
            target=lambda: bot.infinity_polling(timeout=30, long_polling_timeout=20),
            daemon=True
        )
        t.start()
        return t
    else:
        bot.infinity_polling(timeout=30, long_polling_timeout=20)


if __name__ == "__main__":
    start_bot(background=False)

