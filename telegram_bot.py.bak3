@bot.message_handler(commands=["ls"])
def cmd_ls(message):
    """列出專案所有 .py 檔案"""
    if not _is_allowed(message): return
    import pathlib
    files = sorted(pathlib.Path(".").glob("*.py"))
    if not files:
        bot.reply_to(message, "找不到任何 .py 檔案")
        return
    lines = ["📁 專案檔案清單：\n"]
    for i, f in enumerate(files, 1):
        size = f.stat().st_size
        lines.append(f"{i}. {f.name} ({size} bytes)")
    bot.reply_to(message, "\n".join(lines))

@bot.message_handler(commands=["read"])
def cmd_read(message):
    """讀取指定檔案內容，用法：/read reflex_engine.py"""
    if not _is_allowed(message): return
    parts = message.text.split(" ", 1)
    if len(parts) < 2:
        bot.reply_to(message, "用法：/read 檔名.py\n例如：/read reflex_engine.py")
        return
    fname = parts[1].strip()
    import pathlib
    f = pathlib.Path(fname)
    if not f.exists():
        bot.reply_to(message, f"找不到檔案：{fname}")
        return
    content = f.read_text(encoding="utf-8", errors="ignore")
    # Telegram 限制 4096 字
    if len(content) > 3800:
        content = content[:3800] + "\n...（已截斷，檔案過長）"
    bot.reply_to(message, f"📄 {fname}：\n\n```python\n{content}\n```")

@bot.message_handler(commands=["restore"])
def cmd_restore(message):
    """還原檔案到最新備份，用法：/restore reflex_engine.py"""
    if not _is_allowed(message): return
    parts = message.text.split(" ", 1)
    if len(parts) < 2:
        bot.reply_to(message, "用法：/restore 檔名.py")
        return
    fname = parts[1].strip()
    try:
        from self_dev_engine import get_engine
        result = get_engine().restore(fname)
        bot.reply_to(message, result)
    except Exception as e:
        bot.reply_to(message, f"錯誤：{e}")

# ── Claude 橋接指令 ──────────────────────────────────────────────────────────

@bot.message_handler(commands=["claude"])
def cmd_claude(message):
    """手機觸發 Claude 學習對話，用法：/claude 系統設計與架構"""
    if not _is_allowed(message): return
    parts = message.text.split(" ", 1)
    if len(parts) < 2:
        bot.reply_to(message, "用法：/claude [問題]\n例如：/claude 系統設計與架構")
        return
    question = parts[1].strip()
    bot.reply_to(message, f"🔄 開始與 Claude 對話學習...\n問題：{question}\n\n完成後會通知你。")
    import threading
    def _run():
        try:
            from claude_desktop_bridge import get_bridge
            bridge = get_bridge()
            summary = bridge.chat_loop(question, max_rounds=9999)  # 無限輪，用 /claude_stop 停
            # 通知已由 chat_loop 內部的 push() 處理，這裡不重複發送
        except Exception as e:
            push(f"❌ Claude 學習失敗：{e}")
    threading.Thread(target=_run, daemon=True).start()


