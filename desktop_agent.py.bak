# ── Qt Log Handler（把 agent_logger 的輸出接到 UI 日誌）──────────────────────
import logging as _logging

class _QtLogHandler(_logging.Handler):
    """把 Python logging 訊息轉送到 LobsterDesktop._log"""
    def __init__(self):
        super().__init__()
        self._ui_ref = None  # 由 LobsterDesktop.__init__ 設定

    def set_ui(self, ui):
        self._ui_ref = ui

    def emit(self, record):
        if self._ui_ref is None:
            return
        try:
            # 格式：[HH:MM:SS] LEVEL [模組] 訊息
            ts  = _logging.Formatter(datefmt="%H:%M:%S").formatTime(record, "%H:%M:%S")
            msg = record.getMessage()
            lvl = record.levelname   # INFO / WARNING / ERROR ...
            mod = record.name        # Agent.self_dev_engine ...
            line = f"[{ts}] {lvl} [{mod}] {msg}"
            # 安全跨執行緒：用 QTimer.singleShot 確保在主執行緒執行
            from PyQt6.QtCore import QTimer
            QTimer.singleShot(0, lambda l=line: self._ui_ref._log(l))
        except Exception:
            pass

_qt_log_handler = _QtLogHandler()
_qt_log_handler.setLevel(_logging.INFO)

# 掛到 Agent root logger
_logging.getLogger("Agent").addHandler(_qt_log_handler)

# ── Workers ──────────────────────────────────────────────────────────────────
class AgentWorker(QThread):
    reply           = pyqtSignal(str)
    log_line        = pyqtSignal(str)
    status_sig      = pyqtSignal(str)
    skip_memory_sig = pyqtSignal(bool)
    claude_bar_sig  = pyqtSignal(bool)  # 顯示/隱藏 Claude 對話停止按鈕
    claude_reply_sig = pyqtSignal(str)   # Claude 橋接回答（不問存入記憶）

    def __init__(self, text, parent=None, mode="chat"):
        super().__init__(parent)
        self.text = text
        self.mode = mode

    def run(self):
        # 確保套件路徑在任何執行緒都可用
        import sys
        _pkg = r"C:\Users\ACER\AppData\Local\Programs\Python\Python311\Lib\site-packages"
        if _pkg not in sys.path:
            sys.path.insert(0, _pkg)
        self.status_sig.emit("running")
        self.log_line.emit(f"[{self._ts()}] [輸入] {self.text}")
        try:
            result = self._call()
            if not result:
                result = "（沒有回應）"
            update_context(self.text, result)
            # 判斷是否來自 Claude 橋接（由 lobster 設定旗標）
            from_claude = getattr(_lobster, "_last_was_bridge", False)
            if _lobster:
                _lobster._last_was_bridge = False
            self.reply.emit(result)
            self.skip_memory_sig.emit(from_claude)
            self.log_line.emit(f"[{self._ts()}] [回覆] {result[:120]}")
            self.status_sig.emit("idle")
        except Exception as e:
            self.reply.emit(f"❌ {e}")
            self.log_line.emit(f"[{self._ts()}] [錯誤] {e}")
            self.status_sig.emit("error")

    def _call(self):
        mode = getattr(self, 'mode', 'chat')
        if _lobster and _reflex and _router:
            _lobster._ui_ref = self.parent()
            _lobster._worker_ref = self  # 傳入 worker 讓背景執行緒可發 signal
            return _lobster.process_input(self.text, _reflex, _router, mode=mode)
        if _lobster:
            return _lobster.run(self.text)
        cmd = self.text.strip()
        if _memory and cmd.startswith("記住："):
            _memory.store(cmd[3:].strip(), tags=["manual"], importance=7)
            return f"✓ 已記住：{cmd[3:].strip()}"
        if _memory and cmd.startswith("搜尋："):
            res = _memory.search(cmd[3:].strip())
            return "\n".join(f"• {r['content'][:80]}" for r in res) if res else "找不到相關記憶"
        return f"（Lobster_Core 未載入）收到：{cmd}"

    def _ts(self): return datetime.datetime.now().strftime("%H:%M:%S")


class VoiceWorker(QThread):
    recognized = pyqtSignal(str)
    status_sig = pyqtSignal(str)

    def run(self):
        if not HAS_SR:
            self.recognized.emit(""); self.status_sig.emit("error"); return
        r = sr.Recognizer()
        try:
            with sr.Microphone() as source:
                self.status_sig.emit("listening")
                r.adjust_for_ambient_noise(source, duration=0.5)
                audio = r.listen(source, timeout=8, phrase_time_limit=15)
            self.recognized.emit(r.recognize_google(audio, language="zh-TW"))
        except Exception:
            self.recognized.emit("")
        finally:
            self.status_sig.emit("idle")


# ── 主視窗 ───────────────────────────────────────────────────────────────────
class LobsterDesktop(QMainWindow):
    # 跨執行緒安全的日誌 signal（子執行緒 emit，主執行緒 slot 寫入 UI）
    _sig_log = pyqtSignal(str)

    def __init__(self):
        super().__init__()
        self.setWindowTitle("立 · AI 系統核心")
        self.setGeometry(100, 80, 1050, 700)
        self.setMinimumSize(800, 560)
        self.setStyleSheet(STYLE)
        self._worker = None
        self._voice_worker = None
        self._start_time = datetime.datetime.now()
        self._mode = "chat"
        self._last_mobile_count = 0       # 手機訊息計數
        # 啟動時跳過已有的歷史訊息，只顯示新訊息
        try:
            if _MOBILE_MSG_FILE.exists():
                _msgs = _json.loads(_MOBILE_MSG_FILE.read_text(encoding="utf-8"))
                self._last_mobile_count = len(_msgs)
        except Exception:
            pass
        self._last_user_input = ""        # 最後一次使用者輸入（糾正用）
        self._last_ai_reply = ""          # 最後一次 AI 回覆（糾正用）
        self._build_ui()
        self._start_timers()
        self._start_telegram_bot()
        # 讓 dev_tool 能找到桌面視窗
        try:
            import desktop_agent as _da_self
            _da_self._desktop_ui_ref = self
        except Exception:
            pass
        # dev_tool 接入（啟動後延遲設定，等 LobsterCore 載入）
        from PyQt6.QtCore import QTimer
        QTimer.singleShot(5000, self._setup_dev_tool)          # 自動啟動 Telegram Bot
        self._start_distributed()           # 自動啟動分散式推論
        # 把自己註冊到 Qt log handler，讓 agent_logger 的輸出顯示在 UI
        _qt_log_handler.set_ui(self)
        # 連接 _sig_log signal 到 _log（讓背景執行緒可以安全更新 UI）
        self._sig_log.connect(self._log)

    def _start_distributed(self):
        """啟動時自動執行 llama-server 分散式推論"""
        import subprocess, threading, pathlib
        bat = pathlib.Path(r"C:\Users\ACER\AppData\Roaming\Microsoft\Windows\Start Menu\Programs\Startup\start_distributed.bat")
        if not bat.exists():
            self._log(f"[{self._ts()}] [系統] 找不到 start_distributed.bat，跳過分散式推論")
            return
        def _run():
            try:
                subprocess.Popen(
                    [str(bat)],
                    shell=True,
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                    cwd=str(bat.parent)
                )
                from PyQt6.QtCore import QTimer
                QTimer.singleShot(0, lambda: self._log(
                    f"[{self._ts()}] [系統] 分散式推論已啟動（llama-server）"
                ))
            except Exception as e:
                from PyQt6.QtCore import QTimer
                QTimer.singleShot(0, lambda: self._log(
                    f"[{self._ts()}] [系統] 分散式推論啟動失敗：{e}"
                ))
        threading.Thread(target=_run, daemon=True).start()

    def _start_telegram_bot(self):
        """直接在背景執行 Telegram Bot 邏輯"""
        import threading
        def _write_queue(user_text, ai_reply):
            """寫入 queue 讓桌面顯示手機對話，同時寫入日誌"""
            try:
                import json, pathlib as pl, datetime
                qf = pl.Path("memory/mobile_queue.json")
                qf.parent.mkdir(exist_ok=True)
                q = []
                if qf.exists():
                    try: q = json.loads(qf.read_text(encoding="utf-8"))
                    except: q = []
                ts = datetime.datetime.now().strftime("%H:%M:%S")
                q.append({"time": ts, "user": user_text, "ai": ai_reply})
                q = q[-20:]
                qf.write_text(json.dumps(q, ensure_ascii=False), encoding="utf-8")
                # 同時寫入日誌
                from PyQt6.QtCore import QTimer
                QTimer.singleShot(0, lambda: self._log(f"[{ts}] [手機] {user_text[:60]}"))
                QTimer.singleShot(50, lambda: self._log(f"[{ts}] [回覆] {ai_reply[:100]}"))
            except Exception:
                pass

        def _run():
            try:
                import sys, re, json, subprocess, pathlib as _pl, datetime as _dt
                _pkg = r"C:\Users\ACER\AppData\Local\Programs\Python\Python311\Lib\site-packages"
