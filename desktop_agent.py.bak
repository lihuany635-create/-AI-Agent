                def on_cancel(m):
                    if not is_ok(m): return
                    try:
                        from dev_tool import get_tool
                        get_tool().handle_callback("dt_stop")
                        result = "❌ 已取消"
                        bot.reply_to(m, result)
                    except Exception as e:
                        bot.reply_to(m, f"錯誤：{e}")

                @bot.message_handler(commands=["restore"])
                def on_restore(m):
                    if not is_ok(m): return
                    parts = m.text.split(" ", 1)
                    if len(parts) < 2:
                        bot.reply_to(m, "用法：/restore reflex_engine.py")
                        return
                    try:
                        result = "❌ 還原功能已移至 dev_tool"  # from self_dev_engine import get_engine
                        # result = get_engine().restore(parts[1].strip())
                        bot.reply_to(m, result)
                    except Exception as e:
                        bot.reply_to(m, f"錯誤：{e}")

                @bot.message_handler(commands=["history"])
                def on_history(m):
                    if not is_ok(m): return
                    try:
                        result = "（開發歷史功能移至 dev_tool）"
                        bot.reply_to(m, f"開發歷史：\n{result}")
                    except Exception as e:
                        bot.reply_to(m, f"錯誤：{e}")

                @bot.message_handler(commands=["help"])
                def on_help(m):
                    if not is_ok(m): return
                    bot.reply_to(m,
                        "指令清單：\n\n"
                        "模式\n"
                        "/mode - 查看目前模式\n"
                        "/mode chat - 對話模式\n"
                        "/mode terminal - 終端模式\n"
                        "/mode dev - 自主開發模式\n"
                        "/mode teach - 教學模式\n\n"
                        "一般\n"
                        "/status - 系統狀態\n"
                        "/sysinfo - CPU 記憶體 磁碟\n\n"
                        "電腦控制\n"
                        "/cmd [指令] - 執行終端指令\n"
                        "/open [程式] - 開啟程式\n"
                        "/restart - 重啟 AI\n\n"
                        "檔案\n"
                        "/ls - 列出 .py 檔案\n"
                        "/read [檔名] - 查看程式碼\n\n"
                        "開發\n"
                        "/dev [需求] - 修改程式碼\n"
                        "/confirm - 確認修改\n"
                        "/cancel - 取消\n"
                        "/restore [檔名] - 還原備份\n"
                        "/history - 開發歷史"
                    )

                # 手機模式追蹤
                _bot_mode     = {"current": "chat"}
                _bot_dev_mode = {}  # chat_id → "claude" / "solo"
                _mode_names = {
                    "chat": "對話模式",
                    "terminal": "終端模式",
                    "dev": "自主開發模式",
                    "teach": "教學模式",
                    "database": "資料庫模式",
                    "desktop": "桌面模式",
                }
                _mode_icons = {
                    "chat": "💬",
                    "terminal": "⌨️",
                    "dev": "🤖",
                    "teach": "📚",
                    "database": "🗄",
                    "desktop": "🖥",
                }

                @bot.message_handler(commands=["mode"])
                def on_mode(m):
                    if not is_ok(m): return
                    parts = m.text.split(" ", 1)
                    if len(parts) >= 2:
                        new_mode = parts[1].strip().lower()
                        if new_mode in _mode_names:
                            _bot_mode["current"] = new_mode
                            name = _mode_names[new_mode]
                            bot.reply_to(m, f"已切換到 {name}")
                            _write_queue(f"/mode {new_mode}", f"手機切換到{name}")
                            return
                    # 顯示模式選擇按鈕
                    cur = _mode_names.get(_bot_mode["current"], "")
                    bot.send_message(m.chat.id,
                        f"目前模式：{cur}\n請選擇：",
                        reply_markup=_mode_keyboard()
                    )

                def _db_reply_keyboard():
                    """資料庫模式的固定底部按鍵列"""
                    from telebot.types import ReplyKeyboardMarkup, KeyboardButton
                    kb = ReplyKeyboardMarkup(resize_keyboard=True, row_width=2)
                    kb.add(
                        KeyboardButton("🧠 查看記憶庫"),
                        KeyboardButton("🎓 Claude知識庫"),
                        KeyboardButton("💬 ChatGPT知識庫"),
                        KeyboardButton("📖 模組說明"),
                        KeyboardButton("🔍 搜尋記憶"),
                        KeyboardButton("📊 系統狀態"),
                    )
                    return kb

                def _remove_reply_keyboard():
                    """移除固定底部按鍵列"""
                    from telebot.types import ReplyKeyboardRemove
                    return ReplyKeyboardRemove()

                @bot.callback_query_handler(func=lambda call: call.data.startswith("mode_"))
                def on_mode_callback(call):
                    mode_id = call.data.replace("mode_", "")
                    if mode_id in _mode_names:
                        prev_mode = _bot_mode["current"]
                        _bot_mode["current"] = mode_id
                        name = _mode_names.get(mode_id, mode_id)
                        cid  = call.message.chat.id
                        bot.answer_callback_query(call.id, f"已切換到 {name}")

                        if mode_id == "dev":
                            # 自主開發模式：直接顯示開發方式選擇
                            from telebot.types import InlineKeyboardMarkup, InlineKeyboardButton
                            kb = InlineKeyboardMarkup(row_width=1)
                            kb.add(
                                InlineKeyboardButton("🤝 與 Claude 共同開發", callback_data="devmode_claude"),
                                InlineKeyboardButton("🦾 立AI 自己開發",      callback_data="devmode_solo"),
                            )
                            try:
                                bot.edit_message_text(
                                    "🤖 自主開發模式\n\n請選擇開發方式：",
                                    chat_id=cid, message_id=call.message.message_id,
                                    reply_markup=kb
                                )
                            except Exception:
                                bot.send_message(cid, "🤖 自主開發模式\n\n請選擇開發方式：", reply_markup=kb)
                        else:
                            try:
                                bot.edit_message_text(
                                    f"✅ 已切換到 {name}\n\n請選擇功能：",
                                    chat_id=cid,
                                    message_id=call.message.message_id,
                                    reply_markup=_action_keyboard(mode_id)
                                )
                            except Exception:
                                bot.send_message(cid, f"✅ 已切換到 {name}", reply_markup=_action_keyboard(mode_id))
                            if mode_id == "database":
                                bot.send_message(cid,
                                    "📊 資料庫模式\n底部按鍵可直接查詢。",
                                    reply_markup=_db_reply_keyboard()
                                )
                            elif prev_mode == "database":
                                bot.send_message(cid, f"已切換到 {name}",
                                    reply_markup=_remove_reply_keyboard()
                                )
                        _write_queue(f"/mode {mode_id}", f"手機切換到{name}")

                @bot.callback_query_handler(func=lambda call: call.data == "show_modes")
                def on_show_modes(call):
                    bot.answer_callback_query(call.id, "")
                    bot.edit_message_text(
                        "請選擇模式：",
                        chat_id=call.message.chat.id,
                        message_id=call.message.message_id,
                        reply_markup=_mode_keyboard()
                    )

                @bot.callback_query_handler(func=lambda call: call.data.startswith("act_"))
                def on_act_callback(call):
                    cid = call.message.chat.id
                    act = call.data
                    bot.answer_callback_query(call.id, "⏳ 執行中...")

                    if act == "act_memory":
                        try:
                            items = sorted(_memory._memories,
                                key=lambda m: m["accessed_at"], reverse=True)[:8]
                            lines = ["🧠 最近記憶：\n"]
                            for m in items:
                                lines.append(f"★ {m['content'][:60]}")
                            bot.send_message(cid, "\n".join(lines))
                        except Exception as e:
                            bot.send_message(cid, f"❌ {e}")

                    elif act == "act_ask_claude":
                        bot.send_message(cid, "請輸入要問 Claude 的問題：\n（直接傳訊息，會自動走橋接）")
                        _bot_mode["pending"] = "ask_claude"

                    elif act == "act_ask_chatgpt":
                        bot.send_message(cid, "請輸入要問 ChatGPT 的問題：")
                        _bot_mode["pending"] = "ask_chatgpt"

                    elif act == "act_teach":
                        bot.send_message(cid, "請輸入要教立 AI 的知識：\n格式：內容（直接傳訊息）")
                        _bot_mode["pending"] = "teach"

                    elif act == "act_ck_stats":
                        try:
                            from claude_knowledge import get_knowledge
                            bot.send_message(cid, get_knowledge().get_stats())
                        except Exception as e:
                            bot.send_message(cid, f"❌ {e}")

                    elif act == "act_logs":
                        try:
                            log_file = pathlib.Path("memory/agent.log")
                            if log_file.exists():
                                lines = log_file.read_text(encoding="utf-8",
                                    errors="ignore").splitlines()
                                recent = "\n".join(lines[-30:])
                                bot.send_message(cid, recent[:4000])
                            else:
                                bot.send_message(cid, "找不到日誌檔案")
                        except Exception as e:
                            bot.send_message(cid, f"❌ {e}")

                    elif act == "act_capabilities":
                        bot.send_message(cid,
                            "⚡ 立 AI 能力：\n\n"
                            "💬 對話：自然語言對話、記憶學習\n"
                            "⌨️ 終端：執行系統指令\n"
                            "🤖 開發：自主生成程式碼\n"
                            "📚 教學：存入記憶庫\n"
                            "🖥 桌面：截圖、視窗控制\n"
                            "🌐 YouTube：摘要字幕\n"
                            "🤝 Claude/ChatGPT：橋接學習"
                        )

                    elif act == "act_repair":
                        import threading
                        def _repair():
                            try:
                                result = subprocess.run(
                                    ["python", "-c",
                                     "from repair_engine import RepairEngine; "
                                     "r=RepairEngine(); print(r.run_diagnosis())"],
                                    capture_output=True, text=True, timeout=30,
                                    encoding="utf-8", errors="ignore", cwd=str(_pl.Path(__file__).parent)
                                )
                                bot.send_message(cid, result.stdout[:4000] or "完成")
                            except Exception as e:
                                bot.send_message(cid, f"❌ {e}")
                        threading.Thread(target=_repair, daemon=True).start()

                    elif act == "act_analyze":
                        bot.send_message(cid, "請輸入要分析的檔名（如：telegram_bot.py）：")
                        _bot_mode["pending"] = "analyze"

                    elif act == "act_module_explain":
                        bot.send_message(cid, "請輸入要查詢的檔名（如：desktop_agent.py）：")
                        _bot_mode["pending"] = "module_explain"

                    elif act == "act_dev_history":
                        try:
                            import json
                            hf = pathlib.Path("memory/dev_history.json")
                            if hf.exists():
                                history = json.loads(hf.read_text(encoding="utf-8"))
                                recent = history[-5:]
                                lines = ["💻 最近開發歷史：\n"]
                                for h in recent:
                                    lines.append(f"✓ {h.get('file','?')} — {h.get('goal','?')[:40]}")
                                bot.send_message(cid, "\n".join(lines))
                            else:
                                bot.send_message(cid, "尚無開發歷史")
                        except Exception as e:
                            bot.send_message(cid, f"❌ {e}")

                    elif act == "act_screenshot":
                        import threading
                        def _ss():
                            try:
                                result = subprocess.run(
                                    ["python", "-c",
                                     "import pyautogui, datetime, pathlib; "
                                     "p=pathlib.Path('memory/screenshots'); p.mkdir(exist_ok=True); "
                                     "f=p/f'ss_{datetime.datetime.now().strftime(\"%H%M%S\")}.png'; "
                                     "pyautogui.screenshot(str(f)); print('截圖：'+str(f))"],
                                    capture_output=True, text=True, timeout=15,
                                    encoding="utf-8", errors="ignore", cwd=str(_pl.Path(__file__).parent)
                                )
                                bot.send_message(cid, result.stdout or "截圖完成")
                            except Exception as e:
                                bot.send_message(cid, f"❌ {e}")
                        threading.Thread(target=_ss, daemon=True).start()

                    elif act == "act_list_windows":
                        try:
                            import pygetwindow as gw
                            wins = [w.title for w in gw.getAllWindows() if w.title][:15]
                            bot.send_message(cid, "🪟 目前視窗：\n" + "\n".join(wins))
                        except Exception as e:
                            bot.send_message(cid, f"❌ {e}")

                    elif act == "act_ls_desktop":
                        try:
                            import os
                            desktop = pathlib.Path.home() / "OneDrive" / "桌面"
                            if not desktop.exists():
                                desktop = pathlib.Path.home() / "Desktop"
                            files = [f.name for f in desktop.iterdir()][:20]
                            bot.send_message(cid, "📁 桌面：\n" + "\n".join(files))
                        except Exception as e:
                            bot.send_message(cid, f"❌ {e}")

                    elif act == "act_sysinfo":
                        try:
                            import psutil
                            cpu = psutil.cpu_percent(interval=1)
                            mem = psutil.virtual_memory()
                            disk = psutil.disk_usage("/")
                            bot.send_message(cid,
                                f"💻 系統資訊\n"
                                f"CPU：{cpu}%\n"
                                f"記憶體：{mem.percent}% ({mem.used//1024//1024}MB/{mem.total//1024//1024}MB)\n"
                                f"磁碟：{disk.percent}%"
                            )
                        except Exception as e:
                            bot.send_message(cid, f"❌ {e}")

                # 記憶存入確認（手機）
                _pending_mobile_mem = {}

                @bot.callback_query_handler(func=lambda call: call.data.startswith("mem_"))
                def on_mem_callback(call):
                    cid = call.message.chat.id
                    pm = _pending_mobile_mem.get(cid)
                    if call.data == "mem_save" and pm:
                        if _lobster:
                            _lobster.episodic.store(pm["input"], pm["reply"])
                            _lobster.reflex_memory.learn(pm["input"], pm["reply"])
                        bot.answer_callback_query(call.id, "已存入記憶")
                        bot.edit_message_text("已存入記憶",
                            chat_id=cid, message_id=call.message.message_id)
                        _pending_mobile_mem.pop(cid, None)
                    elif call.data == "mem_skip":
                        bot.answer_callback_query(call.id, "已跳過")
                        bot.edit_message_text("已跳過",
                            chat_id=cid, message_id=call.message.message_id)
                        _pending_mobile_mem.pop(cid, None)

                # 開發方式選擇（與Claude共同開發 / 立AI自己開發）
                @bot.callback_query_handler(func=lambda call: call.data.startswith("devmode_"))
                def on_devmode_callback(call):
                    cid  = call.message.chat.id
                    mode = call.data.replace("devmode_", "")
                    _bot_dev_mode[cid] = mode
                    try:
                        bot.edit_message_reply_markup(cid, call.message.message_id, reply_markup=None)
                    except Exception:
                        pass
                    if mode == "solo":
                        bot.answer_callback_query(call.id, "🦾 立AI自己開發")
                        bot.send_message(cid,
                            "🦾 立AI自己開發模式\n\n"
                            "立AI會從知識庫找經驗自己生成，不問 Claude。\n\n"
                            "請直接輸入需求：")
                    else:
                        bot.answer_callback_query(call.id, "🤝 與Claude共同開發")
                        bot.send_message(cid,
                            "🤝 與 Claude 共同開發模式\n\n"
                            "立AI會先與 Claude 討論規格，再逐步製作。\n\n"
                            "請直接輸入需求：")

                # dev_tool 的 callback（dt_ 前綴）
                @bot.callback_query_handler(func=lambda call: call.data.startswith("dt_"))
                def on_dt_callback(call):
                    cid = call.message.chat.id
                    if not is_ok(call.message): return
                    bot.answer_callback_query(call.id, "⏳ 處理中...")
                    try:
                        from dev_tool import get_tool
                        handled = get_tool().handle_callback(call.data)
                        if not handled:
                            bot.send_message(cid, f"❌ 未知指令：{call.data}")
                    except Exception as e:
                        bot.send_message(cid, f"❌ 執行失敗：{e}")
                    try:
                        bot.edit_message_reply_markup(
                            cid, call.message.message_id, reply_markup=None
                        )
                    except Exception:
                        pass

                # 開發確認（手機按鈕）
                @bot.callback_query_handler(func=lambda call: call.data in ["dev_confirm", "dev_cancel"] or call.data.startswith("dev_start_") or call.data.startswith("dev_model_") or call.data == "dev_back_models")
                def on_dev_callback(call):
                    cid = call.message.chat.id
                    if not is_ok(call.message): return

                    # 第一層：選模型 → 推送第二層步驟
                    if call.data.startswith("dev_model_"):
                        model_key = call.data.replace("dev_model_", "")
                        bot.answer_callback_query(call.id, "載入步驟...")
                        try:
                            from dev_tool import get_tool
                            get_tool().select_group(model_key)
                        except Exception as e:
                            bot.send_message(cid, f"❌ 載入步驟失敗：{e}")
                        return

                    # 返回第一層
                    if call.data == "dev_back_models":
                        bot.answer_callback_query(call.id, "返回模型選擇")
                        try:
                            from dev_tool import get_tool as _dt_ref
                            get_tool()._push_mindmap()
                            req = _model_step_map.get("request", "")
                            steps = _model_step_map.get("steps", [])
                            _push_mindmap_to_phone(req, "", steps)
                        except Exception as e:
                            bot.send_message(cid, f"❌ 返回失敗：{e}")
                        return

                    # 第二層：選步驟 → 確認開始製作
                    if call.data.startswith("dev_start_"):
                        try:
                            step_idx = int(call.data.replace("dev_start_", ""))
                            from dev_tool import get_tool as _dt
                            if _dt().state.active:
                                _plan_state["current_step"] = step_idx
                                _plan_state["pending_write"] = {}
                                step = _plan_state["steps"][step_idx]
                                bot.answer_callback_query(call.id, f"步驟 {step_idx+1}")
                                from telebot.types import InlineKeyboardMarkup, InlineKeyboardButton
                                kb = InlineKeyboardMarkup()
                                kb.row(
                                    InlineKeyboardButton("✅ 確認開始製作", callback_data="dev_confirm"),
                                    InlineKeyboardButton("⬅️ 返回", callback_data="dev_back_models"),
                                )
                                bot.send_message(cid,
                                    f"▶️ 步驟 {step_idx+1}：{step['title']}\n"
                                    f"   📄 {step['file']}\n\n"
                                    f"{step.get('desc','')[:150]}\n\n"
                                    f"確認開始製作這個步驟？",
                                    reply_markup=kb
                                )
                            else:
                                bot.answer_callback_query(call.id, "沒有進行中的計畫")
                        except Exception as e:
                            bot.send_message(cid, f"❌ 跳步失敗：{e}")
                        return


                @bot.message_handler(func=lambda m: True)
                def on_msg(m):
                    if not is_ok(m): return
                    text = m.text.strip()
                    # 手動路由指令（確保在執行緒內也能正確執行）
                    if text.startswith("/"):
                        cmd = text.split()[0].lower()
                        if cmd == "/cmd":        on_cmd(m)
                        elif cmd == "/open":     on_open(m)
                        elif cmd == "/ls":       on_ls(m)
                        elif cmd == "/read":     on_read(m)
                        elif cmd == "/sysinfo":  on_sysinfo(m)
                        elif cmd == "/restart":  on_restart(m)
                        elif cmd == "/dev":      on_dev(m)
                        elif cmd == "/confirm":  on_confirm(m)
                        elif cmd == "/cancel":   on_cancel(m)
                        elif cmd == "/restore":  on_restore(m)
                        elif cmd == "/history":  on_history(m)
                        elif cmd == "/help":     on_help(m)
                        elif cmd == "/status":   on_status(m)
                        elif cmd == "/start":    on_start(m)
                        elif cmd == "/mode":     on_mode(m)
                        elif cmd == "/analyze":
                            parts = m.text.split(" ", 1)
                            fname = parts[1].strip() if len(parts) > 1 else ""
                            if fname:
                                import threading
                                def _do_analyze():
                                    try:
                                        r = subprocess.run(
                                            ["python", "analyze_module.py"] + fname.split(),
                                            capture_output=True, text=True, timeout=15,
                                            encoding="utf-8", errors="ignore",
                                            cwd=str(_pl.Path(__file__).parent)
                                        )
                                        out = r.stdout or r.stderr or "（無輸出）"
                                        bot.send_message(m.chat.id, out[:4000])
                                    except Exception as e:
                                        bot.send_message(m.chat.id, f"❌ {e}")
                                threading.Thread(target=_do_analyze, daemon=True).start()
                            else:
                                bot.reply_to(m, "用法：/analyze 檔名.py")
                        _write_queue(text, f"已執行 {cmd}")
                        return

                    # 處理 pending 狀態（功能按鈕後等待輸入）
                    pending = _bot_mode.get("pending")
                    if pending:
                        _bot_mode.pop("pending", None)
                        cid = m.chat.id
                        if pending == "ask_claude":
                            bot.send_message(cid, "⏳ 問 Claude 中...")
                            import threading
                            def _ask_c():
                                try:
                                    from claude_desktop_bridge import get_bridge
                                    ans = get_bridge().ask(text, auto_learn=True)
                                    bot.send_message(cid, ans[:4000])
                                except Exception as e:
                                    bot.send_message(cid, f"❌ {e}")
                            threading.Thread(target=_ask_c, daemon=True).start()
                            return
                        elif pending == "ask_chatgpt":
                            bot.send_message(cid, "⏳ 問 ChatGPT 中...")
                            import threading
                            def _ask_gpt():
                                try:
                                    from chatgpt_desktop_bridge import get_bridge
                                    ans = get_bridge().ask(text, auto_learn=True)
                                    bot.send_message(cid, ans[:4000])
                                except Exception as e:
                                    bot.send_message(cid, f"❌ {e}")
                            threading.Thread(target=_ask_gpt, daemon=True).start()
                            return
                        elif pending == "teach":
                            try:
                                if _memory:
                                    _memory.store(text, tags=["user_teach"], importance=8, source="mobile")
                                    bot.send_message(cid, "✅ 已存入記憶庫")
                            except Exception as e:
                                bot.send_message(cid, f"❌ {e}")
                            return
                        elif pending == "analyze":
                            import threading
                            def _do_a():
                                try:
                                    r = subprocess.run(
                                        ["python", "analyze_module.py"] + text.split(),
                                        capture_output=True, text=True, timeout=15,
                                        encoding="utf-8", errors="ignore",
                                        cwd=str(_pl.Path(__file__).parent)
                                    )
                                    out = r.stdout or r.stderr or "（無輸出）"
                                    bot.send_message(cid, out[:4000])
                                except Exception as e:
                                    bot.send_message(cid, f"❌ {e}")
                            threading.Thread(target=_do_a, daemon=True).start()
                            return

                        elif pending == "module_explain":
                            import threading, pathlib as _pl2
                            fname = text.strip()
                            if not fname.endswith(".py"):
                                fname += ".py"
                            def _do_explain():
                                try:
                                    fpath = _pl2.Path(fname)
                                    if not fpath.exists():
                                        bot.send_message(cid, f"找不到 {fname}")
                                        return
                                    head = "\n".join(fpath.read_text(encoding="utf-8", errors="ignore").splitlines()[:80])
                                    prompt = (
                                        f"以下是 Python 模組 {fname} 的前 80 行程式碼：\n\n{head}\n\n"
                                        f"請用繁體中文，2-4 句說明這個模組的功能和用途，簡單清楚。"
                                    )
                                    from ollama_guard import safe_infer
                                    result = safe_infer(prompt=prompt, model="qwen2.5:14b", timeout=60)
                                    bot.send_message(cid, f"📖 {fname}\n\n{result[:3000]}")
                                except Exception as e:
                                    bot.send_message(cid, f"❌ {e}")
                            bot.send_message(cid, f"正在分析 {fname}，請稍候...")
                            threading.Thread(target=_do_explain, daemon=True).start()
                            return

                    # 自然語言切換模式（「換介面」「切換模式」「換模式」）
                    switch_triggers = ["換介面", "切換模式", "換模式", "選模式", "切換介面"]
                    if any(t in text for t in switch_triggers):
                        cur = _mode_names.get(_bot_mode["current"], "")
                        bot.send_message(m.chat.id,
                            f"目前模式：{cur}\n請選擇：",
                            reply_markup=_mode_keyboard()
                        )
                        return

                    from PyQt6.QtCore import QTimer as _QT
                    _ts_now = self._ts()
                    _QT.singleShot(0, lambda _t=_ts_now, _txt=text[:50]: self._log(f"[{_t}] [手機] {_txt}"))
                    bot.send_chat_action(m.chat.id, "typing")

                    # YouTube 連結處理
                    try:
                        from youtube_telegram import handle_youtube_msg
                        if handle_youtube_msg(bot, m, _lobster):
                            _write_queue(text, "[YouTube摘要已回傳]")
                            return
                    except Exception:
                        pass

                    mode = _bot_mode["current"]

                    # 教學模式：直接存記憶庫 + 讀取檔案
                    if mode == "teach":
                        import re as _re_mt
                        file_match = _re_mt.search(r'(讀取|學習|read)\s+(.+\.\w+)', text)
                        if file_match:
                            # 讀取檔案學習
                            filepath = file_match.group(2).strip()
                            try:
                                import pathlib as _pl_mt
                                f = _pl_mt.Path(filepath)
                                if not f.exists():
                                    f = _pl_mt.Path("learn_inbox") / filepath
                                if not f.exists():
                                    bot.reply_to(m, f"找不到檔案：{filepath}")
                                    return
                                ext = f.suffix.lower()
                                if ext == ".pdf":
                                    try:
                                        from pypdf import PdfReader
                                        reader = PdfReader(str(f))
                                        content = ""
                                        for page in reader.pages[:10]:
                                            pt = page.extract_text()
                                            if pt: content += pt + "\n"
                                    except ImportError:
                                        bot.reply_to(m, "需要 pip install pypdf")
                                        return
                                else:
                                    content = f.read_text(encoding="utf-8", errors="ignore")
                                if not content.strip():
                                    bot.reply_to(m, f"檔案內容為空：{f.name}")
                                    return
                                import re as _re_split
                                paragraphs = _re_split.split(r'\n{2,}', content)
                                count = 0
                                for para in paragraphs:
                                    para = para.strip()
                                    if len(para) < 10: continue
                                    if len(para) > 300:
                                        for i in range(0, len(para), 250):
                                            sub = para[i:i+250].strip()
                                            if len(sub) >= 10 and _memory:
                                                _memory.store(sub, tags=["file_learn", f.name], importance=6, source="mobile_teach")
                                                count += 1
                                    else:
                                        if _memory:
                                            _memory.store(para, tags=["file_learn", f.name], importance=6, source="mobile_teach")
                                            count += 1
                                bot.reply_to(m, f"已從 {f.name} 學習 {count} 段知識")
                            except Exception as e:
                                bot.reply_to(m, f"讀取失敗：{e}")
                            return

                        # 一般知識輸入
                        if _memory:
                            _memory.store(text, tags=["user_teach", "mobile"], importance=8, source="mobile_teach")
                            bot.reply_to(m, f"已記住：{text[:60]}")
                            _write_queue(f"[教學] {text}", "已記住")
                        else:
                            bot.reply_to(m, "記憶庫未載入")
                        return

                    # 資料庫模式：底部按鍵文字對應
                    if mode == "database":
                        db_map = {
                            "🧠 查看記憶庫":    "act_memory",
                            "🎓 Claude知識庫":  "act_ck_stats",
                            "💬 ChatGPT知識庫": "act_gpt_knowledge",
                            "📖 模組說明":      "act_module_explain",
                            "📊 系統狀態":      "act_sysinfo",
                        }
                        if text in db_map:
                            # 模擬 act_ callback
                            class _FakeCall:
                                data = db_map[text]
                                class message:
                                    chat = type('C', (), {'id': m.chat.id})()
                            try:
                                on_act_callback(_FakeCall())
                            except Exception as e:
                                bot.reply_to(m, f"❌ {e}")
                            return
                        if text == "🔍 搜尋記憶":
                            bot.reply_to(m, "請輸入搜尋關鍵字：")
                            _bot_mode["pending"] = "search_memory"
                            return
                        # 一般文字 → 搜尋記憶庫
                        if _bot_mode.get("pending") == "search_memory" or not any(text.startswith(c) for c in ['/', '!']):
                            _bot_mode.pop("pending", None)
                            try:
                                from claude_knowledge import get_knowledge
                                results = get_knowledge().search(text, top_k=3)
                                if results:
                                    lines = [f"📚 找到 {len(results)} 筆："]
                                    for r in results:
                                        lines.append(f"\n• {r.get('question','')[:60]}\n  {r.get('answer','')[:100]}")
                                    bot.reply_to(m, "\n".join(lines)[:4000])
                                else:
                                    if _memory:
                                        mems = _memory.search(text, top_k=3)
                                        if mems:
                                            lines = [f"🧠 記憶庫找到 {len(mems)} 筆："]
                                            for mem in mems:
                                                lines.append(f"• {mem.get('content','')[:80]}")
                                            bot.reply_to(m, "\n".join(lines))
                                            return
                                    bot.reply_to(m, f"找不到「{text[:30]}」的相關資料")
                            except Exception as e:
                                bot.reply_to(m, f"❌ 查詢失敗：{e}")
                            return

                    # 終端模式：直接執行指令
                    if mode == "terminal":
                        try:
                            from terminal_engine import get_terminal
                            result = get_terminal().handle(text)
                            if result:
                                bot.reply_to(m, result)
                                _write_queue(f"[終端] {text}", result[:100])
                                return
                        except Exception:
                            pass

                    # 開發指令攔截
                    import re as _re
                    dev_keywords = ["修改", "新增", "幫我改", "幫我加", "建立", "寫一個", "開發"]
                    app_keywords = ["程式", "應用程式", "系統", "工具", "軟體", "視窗", "介面"]
                    has_py = bool(_re.search(r"\w+\.py", text))
                    has_dev = any(kw in text for kw in dev_keywords)
                    has_app = any(kw in text for kw in app_keywords)

                    # 確認/取消
                    if text.strip() in ["確認", "好", "執行", "yes", "ok"]:
                        try:
                            from dev_tool import get_tool
                            if get_tool().state.active:
                                bot.reply_to(m, "執行中...")
                                result = get_engine().confirm()
                                bot.reply_to(m, result)
                                return
                        except Exception:
                            pass

                    if text.strip() in ["取消", "不", "算了", "cancel"]:
                        try:
                            from dev_tool import get_tool
                            if get_tool().state.active:
                                result = get_engine().cancel()
                                bot.reply_to(m, result)
                                return
                        except Exception:
                            pass

                    # 修改單一檔案
                    if has_py and has_dev:
                        try:
                            from dev_tool import get_tool
                            _tool = get_tool()
                            _dev_md = _bot_dev_mode.get(m.chat.id, "claude")
                            if _dev_md == "solo":
                                try:
                                    from claude_knowledge import get_knowledge
                                    _rs = get_knowledge().search(text, top_k=5)
                                    _tool.state.solo_context = ("\n".join(
                                        [f"• {r.get('question','')[:60]}\n  {r.get('answer','')[:80]}" for r in _rs]
                                    ) if _rs else "（無相關經驗）")
                                except Exception:
                                    _tool.state.solo_context = ""
                            else:
                                _tool.state.solo_context = ""
                            threading.Thread(target=_tool.start, args=(text.strip(),), daemon=True).start()
                            bot.reply_to(m, "🤖 開始規劃...")
                            result = get_engine().handle(text)
                            bot.reply_to(m, result)
                            return
                        except Exception as e:
                            bot.reply_to(m, f"開發錯誤：{e}")
                            return

                    # 完整應用程式
                    if has_dev and has_app:
                        try:
                            from autonomous_dev import get_auto_dev
                            bot.reply_to(m, "開始自主開發，完成後通知你...")
                            import threading
                            def _dev():
                                result = get_auto_dev().build(text)
                                bot.send_message(m.chat.id, result)
                            threading.Thread(target=_dev, daemon=True).start()
                            return
                        except Exception as e:
                            bot.reply_to(m, f"錯誤：{e}")
                            return

                    # 傳給 AI（用已載入的全域 Lobster_Core，傳入手機的模式）
                    try:
                        if _lobster and _reflex and _router:
                            reply = _lobster.process_input(text, _reflex, _router, mode=mode)
                        elif _lobster:
                            reply = _lobster.run(text)
                        else:
                            reply = "AI 核心未載入"
                    except Exception as e:
                        reply = f"AI 錯誤：{e}"

                    if not reply:
                        reply = "（沒有回應）"
                    if len(reply) > 4000:
                        reply = reply[:4000] + "...（已截斷）"

                    bot.reply_to(m, reply)

                    # 問要不要存入記憶（用 inline 按鈕）
                    if mode == "chat" and "[LLM ERROR]" not in reply:
                        # 檢查是否已學過
                        already_known = False
                        if _lobster:
                            cached = _lobster.reflex_memory.get(text)
                            if cached:
                                already_known = True
                            if not already_known:
                                recent = _lobster.episodic.search_recent(20)
                                for ep in recent:
                                    if ep.get("input", "").strip() == text.strip():
                                        already_known = True
                                        break

                        if not already_known:
                            from telebot.types import InlineKeyboardMarkup, InlineKeyboardButton
                            _pending_mobile_mem[m.chat.id] = {"input": text, "reply": reply}
                            mem_kb = InlineKeyboardMarkup(row_width=2)
                            mem_kb.add(
                                InlineKeyboardButton("存入記憶", callback_data="mem_save"),
                                InlineKeyboardButton("跳過", callback_data="mem_skip"),
                            )
                            bot.send_message(m.chat.id, "存入記憶庫？", reply_markup=mem_kb)

                    # 寫入 queue 讓桌面顯示
                    try:
                        qf = pathlib.Path("memory/mobile_queue.json")
                        qf.parent.mkdir(exist_ok=True)
                        q = []
                        if qf.exists():
                            try: q = json.loads(qf.read_text(encoding="utf-8"))
                            except: q = []
                        q.append({"time": datetime.datetime.now().strftime("%H:%M:%S"), "user": text, "ai": reply})
                        q = q[-20:]
                        qf.write_text(json.dumps(q, ensure_ascii=False), encoding="utf-8")
                    except: pass

                # 推送上線通知（附帶模式選擇按鈕）
                for cid in allowed:
                    try:
                        bot.send_message(cid,
                            "立 AI 桌面已開啟！\n目前模式：對話模式\n\n直接傳訊息或選擇模式：",
                            reply_markup=_mode_keyboard()
                        )
                    except: pass

                from PyQt6.QtCore import QTimer as _QT2
                _ts2 = self._ts()
                _QT2.singleShot(0, lambda: self._log(f"[{_ts2}] [系統] Telegram Bot 已啟動"))
                bot.infinity_polling(timeout=30, long_polling_timeout=20)

            except ImportError as ie:
                from PyQt6.QtCore import QTimer as _QT3
                _ts3 = self._ts()
                _msg3 = str(ie)
                _QT3.singleShot(0, lambda: self._log(f"[{_ts3}] [系統] Bot 啟動失敗（{_msg3}），跳過"))
            except Exception as e:
                from PyQt6.QtCore import QTimer as _QT4
                _ts4 = self._ts()
                _msg4 = str(e)
                _QT4.singleShot(0, lambda: self._log(f"[{_ts4}] [系統] Telegram Bot 錯誤：{_msg4}"))

        t = threading.Thread(target=_run, daemon=True)
        t.start()
        self._log(f"[{self._ts()}] [系統] Telegram Bot 啟動中...")

    def _build_ui(self):
        root = QWidget(); self.setCentralWidget(root)
        v = QVBoxLayout(root); v.setContentsMargins(8, 6, 8, 8); v.setSpacing(6)
        v.addWidget(self._header())
        v.addWidget(self._mode_bar())
        sp = QSplitter(Qt.Orientation.Horizontal)
        sp.addWidget(self._left_panel())
        sp.addWidget(self._tabs())
        sp.setSizes([260, 800]); sp.setHandleWidth(2)
        v.addWidget(sp, 1)

    def _mode_bar(self):
        """模式切換列"""
        bar = QWidget()
        bar.setStyleSheet("background:#0d1117;border-radius:8px;")
        h = QHBoxLayout(bar); h.setContentsMargins(8,6,8,6); h.setSpacing(6)

        self._mode = "chat"  # 目前模式
        self._mode_btns = {}

        modes = [
            ("chat",    "💬 對話",   "#7F77DD", "#EEEDFE"),
            ("terminal","⌨️ 終端",   "#185FA5", "#E6F1FB"),
            ("dev",     "🤖 自主開發","#0F6E56", "#E1F5EE"),
            ("teach",   "📚 教學",   "#854F0B", "#FAEEDA"),
            ("database","🗄 資料庫",  "#5B3A8A", "#EDE8F7"),
            ("desktop", "🖥 桌面",   "#993C1D", "#FAECE7"),
        ]

        for mode_id, label, fg, bg in modes:
            btn = QPushButton(label)
            style_active  = f"background:{bg};color:{fg};border:none;border-radius:16px;padding:4px 14px;font-size:12px;font-weight:600;"
            style_inactive = "background:transparent;color:#555;border:none;border-radius:16px;padding:4px 14px;font-size:12px;"
            btn.setStyleSheet(style_active if mode_id == "chat" else style_inactive)
            btn.clicked.connect(lambda checked=False, m=mode_id: self._switch_mode(m, []))
            self._mode_btns[mode_id] = (btn, style_active, style_inactive)
            h.addWidget(btn)

        h.addStretch()
        self._mode_label = QLabel("對話模式 — 直接問立任何問題")
        self._mode_label.setStyleSheet("color:#444;font-size:11px;")
        h.addWidget(self._mode_label)
        return bar

    def _switch_mode(self, mode_id: str, modes_list: list):
        """切換模式"""
        self._mode = mode_id
        mode_names = {
            "chat":     ("對話模式 — 直接問立任何問題", "輸入問題，按 Enter 傳送..."),
            "terminal": ("終端模式 — 直接執行指令", "dir / python xxx.py / git status / ipconfig..."),
            "dev":      ("自主開發模式 — 說需求，立自己完成", "例如：幫我做一個 BMI 計算機，有 PyQt6 介面"),
            "teach":    ("教學模式 — 問Claude/ChatGPT、新增知識", "輸入知識或直接提問..."),
            "database": ("資料庫模式 — 管理記憶與知識庫", "查詢、瀏覽所有知識庫..."),
            "desktop":  ("桌面控制模式 — 直接執行桌面指令", "截圖 / 列出視窗 / 查看資料夾..."),
        }
        mode_icons = {"chat":"💬", "terminal":"⌨️", "dev":"🤖", "teach":"📚", "database":"🗄", "desktop":"🖥"}
        desc, placeholder = mode_names.get(mode_id, ("", ""))
        self._mode_label.setText(desc)
        self.input_box.setPlaceholderText(placeholder)

        # 更新按鈕樣式
        for mid, (btn, active_style, inactive_style) in self._mode_btns.items():
            btn.setStyleSheet(active_style if mid == mode_id else inactive_style)

        # 更新左側快速操作
        self._refresh_quick_actions(mode_id)

        # 在對話框顯示模式切換提示
        icon = mode_icons.get(mode_id, "")
        self.chat_history.append(
            f'<div style="text-align:center;margin:8px 0;">'
            f'<span style="background:#1a1d27;color:#888;border-radius:12px;padding:4px 16px;font-size:11px;">'
            f'{icon} 已切換到{desc.split("—")[0].strip()}</span></div>')
        self.chat_history.moveCursor(QTextCursor.MoveOperation.End)

        # 切換到對話頁
        self.tabs.setCurrentIndex(0)

    def _header(self):
        f = QFrame(); f.setObjectName("card")
        h = QHBoxLayout(f); h.setContentsMargins(14, 8, 14, 8)
        t = QLabel("🦞  立 · AI 系統核心")
        t.setStyleSheet("color:#7eb8f7;font-size:16px;font-weight:700;")
        h.addWidget(t); h.addStretch()
        self.lbl_status = QLabel("● idle")
        self.lbl_status.setStyleSheet("color:#4ade80;font-weight:600;")
        h.addWidget(self.lbl_status)
        self.lbl_clock = QLabel("")
        self.lbl_clock.setStyleSheet("color:#555;font-size:12px;margin-left:12px;")
        h.addWidget(self.lbl_clock)
        return f

    def _left_panel(self):
        w = QWidget()
        v = QVBoxLayout(w); v.setContentsMargins(0, 0, 6, 0); v.setSpacing(8)
        # 狀態卡
        c = QFrame(); c.setObjectName("card")
        cv = QVBoxLayout(c); cv.setContentsMargins(12, 10, 12, 10); cv.setSpacing(5)
        cv.addWidget(self._sec("系統狀態"))
        self.stat_mem    = self._stat_row("記憶筆數", "—")
        self.stat_task   = self._stat_row("排程任務", "—")
        self.stat_uptime = self._stat_row("運行時間", "0s")
        for w2 in [self.stat_mem, self.stat_task, self.stat_uptime]: cv.addWidget(w2)
        v.addWidget(c)
        # ── AB 節點狀態卡 ──────────────────────────────────────────────
        cn = QFrame(); cn.setObjectName("card")
        cnv = QVBoxLayout(cn); cnv.setContentsMargins(12, 10, 12, 10); cnv.setSpacing(5)
        cnv.addWidget(self._sec("AB 節點"))
        self.stat_node_a    = self._stat_row("電腦 A", "—")
        self.stat_node_b    = self._stat_row("電腦 B", "—")
        self.stat_node_dist = self._stat_row("分散式", "—")
        for w2 in [self.stat_node_a, self.stat_node_b, self.stat_node_dist]: cnv.addWidget(w2)
        v.addWidget(cn)
        # 快速操作
        c2 = QFrame(); c2.setObjectName("card")
        cv2 = QVBoxLayout(c2); cv2.setContentsMargins(12, 10, 12, 10); cv2.setSpacing(6)
        cv2.addWidget(self._sec("快速操作"))
        self._quick_action_layout = cv2
        self._quick_action_btns = []
        for lbl, fn in [
            ("🔧 自動修復", self._quick_repair),
            ("💻 開發歷史", self._show_dev_history),
            ("📚 教立學習", self._show_learn_dialog),
            ("⚡ 查看能力", self._show_capabilities),
        ]:
            b = QPushButton(lbl); b.setObjectName("btn_accent"); b.clicked.connect(fn)
            cv2.addWidget(b)
            self._quick_action_btns.append(b)
        v.addWidget(c2); v.addStretch()
        return w

    def _tabs(self):
        self.tabs = QTabWidget()
        self.tabs.addTab(self._chat_tab(),   "💬  對話")
        self.tabs.addTab(self._log_tab(),    "📋  日誌")
        self.tabs.addTab(self._memory_tab(), "🧠  記憶庫")
        return self.tabs

    def _chat_tab(self):
        w = QWidget(); v = QVBoxLayout(w); v.setContentsMargins(8,8,8,8); v.setSpacing(6)
        self.chat_history = QTextEdit(); self.chat_history.setReadOnly(True)
        self.chat_history.setFont(QFont("Microsoft JhengHei UI", 12))
        self.chat_history.document().setDefaultFont(QFont("Microsoft JhengHei UI", 12))
        v.addWidget(self.chat_history)
        self.progress = QProgressBar(); self.progress.setRange(0,0); self.progress.setVisible(False)
        v.addWidget(self.progress)
        # ── 心智圖選擇列（規格討論完成後顯示）─────────────────────────────
        self.mindmap_frame = QFrame()
        self.mindmap_frame.setObjectName("card")
        self.mindmap_frame.setStyleSheet("background:#0d1117;border-radius:8px;")
        mmv = QVBoxLayout(self.mindmap_frame); mmv.setContentsMargins(10,8,10,8); mmv.setSpacing(6)

        mm_header = QHBoxLayout()
        self.lbl_mindmap_title = QLabel("🗺 選擇開發分組")
        self.lbl_mindmap_title.setStyleSheet("color:#7eb8f7;font-size:12px;font-weight:600;")
        self.btn_mindmap_all = QPushButton("▶ 照順序全做")
