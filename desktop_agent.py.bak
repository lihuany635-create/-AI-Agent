    def _log_tab(self):
        w = QWidget(); v = QVBoxLayout(w); v.setContentsMargins(8,8,8,8); v.setSpacing(6)

        # ── 系統狀態列 ──────────────────────────────────────────────────────
        status_frame = QWidget()
        status_frame.setStyleSheet("background:#0d1117;border-radius:8px;padding:4px;")
        sf = QHBoxLayout(status_frame); sf.setContentsMargins(8,6,8,6); sf.setSpacing(16)

        def _status_label(title, value_attr):
            col = QVBoxLayout(); col.setSpacing(2)
            t = QLabel(title); t.setStyleSheet("color:#555;font-size:10px;")
            val = QLabel("--"); val.setStyleSheet("color:#86efac;font-size:13px;font-weight:600;")
            setattr(self, value_attr, val)
            col.addWidget(t); col.addWidget(val)
            return col

        sf.addLayout(_status_label("Ollama", "lbl_ollama_status"))
        sf.addLayout(_status_label("模型", "lbl_model_status"))
        sf.addLayout(_status_label("記憶", "lbl_mem_status2"))
        sf.addLayout(_status_label("Bot", "lbl_bot_status"))
        sf.addLayout(_status_label("電腦A", "lbl_node_a"))
        sf.addLayout(_status_label("電腦B", "lbl_node_b"))
        sf.addLayout(_status_label("分散式", "lbl_dist"))
        sf.addLayout(_status_label("運行時間", "lbl_uptime_status"))
        sf.addStretch()
        v.addWidget(status_frame)

        # ── 篩選列 ──────────────────────────────────────────────────────────
        filter_row = QHBoxLayout(); filter_row.setSpacing(6)
        self.log_filter = QLineEdit()
        self.log_filter.setPlaceholderText("篩選日誌...")
        self.log_filter.textChanged.connect(self._filter_log)
        filter_row.addWidget(self.log_filter)
        for lbl, fn, tip in [
            ("全部", lambda: self._set_log_filter(""),       "顯示全部"),
            ("手機", lambda: self._set_log_filter("[手機]"), "只看手機"),
            ("錯誤", lambda: self._set_log_filter("ERROR"),  "只看錯誤"),
        ]:
            b = QPushButton(lbl); b.setObjectName("btn_dim")
            b.setFixedWidth(56); b.setToolTip(tip)
            b.clicked.connect(fn); filter_row.addWidget(b)
        v.addLayout(filter_row)

        # ── 日誌框 ──────────────────────────────────────────────────────────
        self.log_box = QTextEdit(); self.log_box.setReadOnly(True)
        self.log_box.setFont(QFont("Consolas", 11))
        self.log_box.setStyleSheet("color:#86efac;background:#0a0c10;")
        v.addWidget(self.log_box)

        row = QHBoxLayout()
        for lbl, fn in [("載入日誌檔", self._load_log), ("清除", self.log_box.clear)]:
            b = QPushButton(lbl); b.setObjectName("btn_dim"); b.setFixedWidth(90); b.clicked.connect(fn); row.addWidget(b)
        row.insertStretch(0); v.addLayout(row)

        # 啟動狀態更新計時器
        self._update_log_status()
        self._log_status_timer = QTimer(self)
        self._log_status_timer.timeout.connect(self._update_log_status)
        self._log_status_timer.start(300000)  # 每 5 分鐘更新一次
        return w

    def _set_log_filter(self, text):
        self.log_filter.setText(text)

    def _filter_log(self, text):
        """篩選日誌內容（只顯示包含關鍵字的行）"""
        # 儲存完整日誌（第一次篩選時記住）
        if not hasattr(self, '_full_log_html'):
            self._full_log_html = self.log_box.toHtml()

        if not text:
            # 清空篩選 → 還原完整日誌
            self.log_box.setHtml(self._full_log_html)
            self.log_box.moveCursor(QTextCursor.MoveOperation.End)
            return

        content = self.log_box.toPlainText()
        lines = [l for l in content.splitlines() if text.lower() in l.lower()]
        if lines:
            self.log_box.setText("\n".join(lines[-200:]))

    def _update_log_status(self):
        """更新狀態列顯示"""
        try:
            # 模型
            if _lobster:
                self.lbl_model_status.setText(_lobster.model.split(":")[0][:12])
            else:
                self.lbl_model_status.setText("未載入")

            # 記憶
            mem_count = len(_memory._memories) if _memory else 0
            self.lbl_mem_status2.setText(f"{mem_count} 筆")

            # Bot
            self.lbl_bot_status.setText("運行中")
            self.lbl_bot_status.setStyleSheet("color:#86efac;font-size:13px;font-weight:600;")

            # 運行時間
            elapsed = datetime.datetime.now() - self._start_time
            h, m = divmod(int(elapsed.total_seconds()), 3600)
            m, s = divmod(m, 60)
            self.lbl_uptime_status.setText(f"{h:02d}:{m:02d}:{s:02d}")

            # Ollama 狀態（背景執行，用 signal 安全回主執行緒）
            def _check_ollama():
                try:
                    import requests as rq
                    rq.get("http://localhost:11434/api/tags", timeout=2)
                    online = True
                except Exception:
                    online = False
                # 用 signal 確保在主執行緒更新
                self._sig_log.emit(f"__ollama_status__{'online' if online else 'offline'}")

            import threading
            threading.Thread(target=_check_ollama, daemon=True).start()

            # AB 節點狀態（由獨立 timer 負責，這裡不再處理）
        except Exception:
            pass

    def _check_nodes_bg(self):
        """背景檢查 AB 節點狀態，用 signal 安全回主執行緒"""
        def _run():
            try:
                from ollama_guard import NODES, _check_node, _should_use_distributed, _check_latency
                for n in NODES:
                    _check_node(n, force=True)
                latency = _check_latency()
                ns = {
                    "local":  {"online": NODES[0]["online"], "latency_ms": None},
                    "remote": {"online": NODES[1]["online"], "latency_ms": latency if NODES[1]["online"] else None},
                }
                dist = _should_use_distributed()
                # 用 signal 安全回主執行緒
                local_ok  = "✅" if ns["local"]["online"]  else "❌"
                remote_ok = "✅" if ns["remote"]["online"] else "❌"
                lat_str   = f"{latency:.0f}ms" if ns["remote"]["online"] and latency else ""
                dist_str  = "✅ 分散式" if dist else "❌"
                self._sig_log.emit(f"__node_status__{local_ok}|{remote_ok}|{lat_str}|{dist_str}")
            except Exception:
                pass
        import threading
        threading.Thread(target=_run, daemon=True).start()

    # ── 心智圖選擇介面 ───────────────────────────────────────────────────────

    def show_mindmap(self, groups: dict, steps: list):
        """
        顯示心智圖分組選擇列（由 dev_tool 觸發）
        groups: {"key": {"label":..., "desc":..., "steps":[idx...]}, ...}
        steps:  完整步驟清單
        """
        from PyQt6.QtCore import QTimer
        QTimer.singleShot(0, lambda: self._show_mindmap_inner(groups, steps))

    def _show_mindmap_inner(self, groups: dict, steps: list):
        self._mindmap_groups = groups
        self._mindmap_steps  = steps

        # 清空舊的分組按鈕
        for i in reversed(range(self.mindmap_group_layout.count())):
            w = self.mindmap_group_layout.itemAt(i).widget()
            if w: w.deleteLater()

        # 建立分組按鈕
        for key, info in groups.items():
            btn = QPushButton(info["label"])
            btn.setStyleSheet(
                "background:#1a2744;color:#93c5fd;border:1px solid #1e3a5f;"
                "border-radius:8px;padding:5px 12px;font-size:12px;"
            )
            btn.setToolTip(info.get("desc", ""))
            btn.clicked.connect(lambda checked=False, k=key: self._on_mindmap_group_click(k))
            self.mindmap_group_layout.addWidget(btn)

        self.mindmap_group_layout.addStretch()
        self.mindmap_step_row.setVisible(False)
        self.mindmap_frame.setVisible(True)
        self.tabs.setCurrentIndex(0)

    def _on_mindmap_group_click(self, group_key: str):
        """使用者點了某個分組 → 顯示該分組的步驟按鈕"""
        groups = getattr(self, '_mindmap_groups', {})
        steps  = getattr(self, '_mindmap_steps', [])
        info   = groups.get(group_key, {})
        step_indices = info.get("steps", [])

        # 清空舊的步驟按鈕
        for i in reversed(range(self.mindmap_step_layout.count())):
            w = self.mindmap_step_layout.itemAt(i).widget()
            if w: w.deleteLater()

        # 建立步驟按鈕
        for idx in step_indices:
            if idx >= len(steps): continue
            step = steps[idx]
            icon = "🆕" if step.get("action") == "create" else "✏️"
            btn = QPushButton(f"{icon} {step['file']}")
            btn.setStyleSheet(
                "background:#0f3460;color:#7eb8f7;border:1px solid #1e4a8f;"
                "border-radius:8px;padding:5px 12px;font-size:12px;"
            )
            btn.setToolTip(step.get("title", "") + "\\n" + step.get("desc", "")[:80])
            btn.clicked.connect(lambda checked=False, i=idx: self._on_mindmap_step_click(i))
            self.mindmap_step_layout.addWidget(btn)

        self.mindmap_step_layout.addStretch()
        self.mindmap_step_row.setVisible(True)

    def _on_mindmap_step_click(self, step_idx: int):
        """使用者點了步驟 → 設定起始步驟，顯示確認列"""
        try:
            from dev_tool import get_tool as _dt
            if _dt().state.active:
                _plan_state["current_step"] = step_idx
                _plan_state["pending_write"] = {}
                step = _plan_state["steps"][step_idx]
                self.mindmap_frame.setVisible(False)
                self._agent_msg(
                    f"▶️ 準備製作步驟 {step_idx+1}：{step['title']}\n"
                    f"   📄 {step['file']}\n\n"
                    f"{step.get('desc','')[:120]}\n\n"
                    f"點「確認執行」開始生成程式碼"
                )
                self.confirm_row.setVisible(True)
                self.lbl_pending.setText(f"步驟 {step_idx+1}：{step['title']} — 等待確認")
        except Exception as e:
            self._agent_msg(f"❌ 跳步失敗：{e}")

    def _on_mindmap_confirm_all(self):
        """從頭開始照順序執行"""
        try:
            from dev_tool import get_tool as _dt
            if _dt().state.active:
                _plan_state["current_step"] = 0
                _plan_state["pending_write"] = {}
                self.mindmap_frame.setVisible(False)
                self.confirm_row.setVisible(True)
                self.lbl_pending.setText("AI 有行動計畫等待確認")
        except Exception as e:
            self._agent_msg(f"❌ 失敗：{e}")

    def _setup_dev_tool(self):
        """啟動後設定 dev_tool 接入立AI大腦，等 bot 準備好再接入"""
        import threading, time

        def _wait_and_setup():
            # 最多等 30 秒讓 bot 啟動
            for _ in range(30):
                bot = getattr(__import__("desktop_agent"), "_bot_instance", None)
                if bot is not None:
                    break
                time.sleep(1)
            try:
                from dev_brain import setup_dev_tool
                import bot_config
                bot = getattr(__import__("desktop_agent"), "_bot_instance", None)
                setup_dev_tool(
                    lobster_core=_lobster,
                    bot=bot,
                    allowed_ids=list(bot_config.ALLOWED_CHAT_IDS),
                )
                self._log(f"[{self._ts()}] [系統] dev_tool 接入完成（bot={'有' if bot else '無'}）")
            except Exception as e:
                self._log(f"[{self._ts()}] [系統] dev_tool 接入失敗：{e}")

        threading.Thread(target=_wait_and_setup, daemon=True).start()

    def _dev_with_claude(self):
        """與 Claude 共同開發模式：走完整規格討論流程"""
        self._agent_msg(
            "🤝 與 Claude 共同開發模式\n\n"
            "請輸入你的需求，立AI會先與 Claude 討論規格和架構，\n"
            "再逐步規劃並製作。\n\n"
            "直接在下方輸入需求開始："
        )
        # 設定旗標：下一個輸入用 claude 共同開發
        self._dev_mode_flag = "claude"

    def _dev_solo(self):
        """立AI自己開發：從知識庫找經驗，不問 Claude"""
        # 先查知識庫有多少可用經驗
        exp_count = 0
        try:
            from claude_knowledge import get_knowledge
            stats = get_knowledge().get_stats()
            import re
            m = re.search(r'(\d+)', stats)
            exp_count = int(m.group(1)) if m else 0
        except Exception:
            pass

        self._agent_msg(
            f"🦾 立AI自己開發模式\n\n"
            f"知識庫中有 {exp_count} 筆開發經驗可參考。\n"
            f"立AI會從經驗庫找相關模式，自己生成程式碼，不需要問 Claude。\n\n"
            f"直接在下方輸入需求開始："
        )
        self._dev_mode_flag = "solo"

    def _dev_solo_handle(self, text: str) -> str:
        """立AI自己開發：從 claude_knowledge 找相關經驗，自己生成"""
        try:
            from claude_knowledge import get_knowledge
            from dev_tool import get_tool

            # 1. 從知識庫搜尋相關經驗
            results = get_knowledge().search(text, top_k=5)
            exp_context = ""
            if results:
                lines = ["以下是知識庫中相關的開發經驗，請參考這些模式生成程式碼："]
                for r in results:
                    q = r.get("question", "")
                    a = r.get("answer", "")[:200]
                    lines.append(f"\n經驗：{q}\n摘要：{a}")
                exp_context = "\n".join(lines)
                self._log(f"[{self._ts()}] [系統] 找到 {len(results)} 筆相關開發經驗")
            else:
                self._log(f"[{self._ts()}] [系統] 知識庫無相關經驗，用本地模型直接生成")

            # 2. 把經驗注入到開發引擎的 prompt context
            eng = get_engine()
            if exp_context:
                # 暫時注入經驗 context 到 _plan_state
                from dev_tool import get_tool
                get_tool().state.solo_context = exp_context

            # 3. 走正常開發流程，但不會問 Claude（因為 _solo_context 已提供經驗）
            result = eng.handle(text)
            return result

        except Exception as e:
            return f"立AI自己開發失敗：{e}"

    def _set_ollama_status(self, online: bool):
        """在主執行緒更新 Ollama 狀態"""
        try:
            if online:
                self.lbl_ollama_status.setText("在線")
                self.lbl_ollama_status.setStyleSheet("color:#86efac;font-size:13px;font-weight:600;")
            else:
                self.lbl_ollama_status.setText("離線")
                self.lbl_ollama_status.setStyleSheet("color:#f87171;font-size:13px;font-weight:600;")
            import logging as _log
            _log.getLogger("Agent.desktop").info(f"[UI] Ollama 狀態更新：{'在線' if online else '離線'}")
        except Exception as e:
            import logging as _log
            _log.getLogger("Agent.desktop").warning(f"[UI] _set_ollama_status 失敗：{e}")

    def _set_node_status(self, nodes: dict, dist_ok: bool):
        """在主執行緒更新 AB 節點狀態（日誌頁 + 左側面板）"""
        node_list = list(nodes.items())
        # 日誌頁頂部狀態列
        for lbl_attr, idx in [("lbl_node_a", 0), ("lbl_node_b", 1)]:
            lbl = getattr(self, lbl_attr, None)
            if lbl is None: continue
            if idx < len(node_list):
                name, info = node_list[idx]
                ok  = info.get("online", False)
                lat = info.get("latency_ms")
                txt = (f"{lat:.0f}ms" if lat is not None else "✅") if ok else "✗"
                col = "#86efac" if ok else "#f87171"
            else:
                txt, col = "—", "#555"
            lbl.setText(txt)
            lbl.setStyleSheet(f"color:{col};font-size:13px;font-weight:600;")
        # 分散式狀態
        if hasattr(self, 'lbl_dist'):
            self.lbl_dist.setText("啟用" if dist_ok else "單機")
            self.lbl_dist.setStyleSheet(f"color:{'#86efac' if dist_ok else '#fbbf24'};font-size:13px;font-weight:600;")
        # 左側面板
        for stat_attr, idx in [("stat_node_a", 0), ("stat_node_b", 1)]:
            stat = getattr(self, stat_attr, None)
            if stat is None: continue
            vl = stat.findChild(QLabel, "val")
            if vl is None: continue
            if idx < len(node_list):
                name, info = node_list[idx]
                ok  = info.get("online", False)
                lat = info.get("latency_ms")
                txt = (f"✅ {lat:.0f}ms" if lat is not None else "✅") if ok else "❌ 離線"
                col = "#86efac" if ok else "#f87171"
            else:
                txt, col = "—", "#555"
            vl.setText(txt)
            vl.setStyleSheet(f"color:{col};font-weight:700;")
        if hasattr(self, 'stat_node_dist'):
            vl = self.stat_node_dist.findChild(QLabel, "val")
            if vl:
                vl.setText("分散式" if dist_ok else "單機")
                vl.setStyleSheet(f"color:{'#86efac' if dist_ok else '#fbbf24'};font-weight:700;")

    def _memory_tab(self):
        w = QWidget(); v = QVBoxLayout(w); v.setContentsMargins(8,8,8,8); v.setSpacing(6)
        row = QHBoxLayout(); row.setSpacing(6)
        self.mem_search = QLineEdit(); self.mem_search.setPlaceholderText("搜尋記憶...")
        self.mem_search.textChanged.connect(self._refresh_memory)
        btn = QPushButton("＋ 新增"); btn.setFixedWidth(72); btn.clicked.connect(self._add_memory)
        row.addWidget(self.mem_search); row.addWidget(btn); v.addLayout(row)
        self.mem_list = QListWidget(); self.mem_list.setSpacing(2)
        self.mem_list.setSelectionMode(QListWidget.SelectionMode.SingleSelection)
        v.addWidget(self.mem_list)
        del_row = QHBoxLayout()
        self.btn_del_mem = QPushButton("刪除選取的記憶")
        self.btn_del_mem.setObjectName("btn_dim")
        self.btn_del_mem.clicked.connect(self._delete_selected_memory)
        del_row.addStretch(); del_row.addWidget(self.btn_del_mem)
        v.addLayout(del_row)
        self.mem_input = QLineEdit(); self.mem_input.setPlaceholderText("輸入要記住的內容...")
        v.addWidget(self.mem_input)
        self._refresh_memory()
        return w

    def _task_tab(self):
        w = QWidget(); v = QVBoxLayout(w); v.setContentsMargins(8,8,8,8); v.setSpacing(6)
        v.addWidget(self._sec("任務佇列"))
        self.task_list = QListWidget(); v.addWidget(self.task_list)
        row = QHBoxLayout(); row.setSpacing(6)
        br = QPushButton("🔄 更新"); br.setObjectName("btn_dim"); br.setFixedWidth(80); br.clicked.connect(self._refresh_tasks)
        bf = QPushButton("🔧 提交修復任務"); bf.clicked.connect(self._quick_repair)
        row.addStretch(); row.addWidget(br); row.addWidget(bf); v.addLayout(row)
        self._refresh_tasks()
        return w

    # ── 動作 ─────────────────────────────────────────────────────────────────

    # ── 模式鎖定：偵測跨模式輸入 ────────────────────────────────────────────
    _MODE_LOCK_RULES = {
        "chat": {
            "desc": "對話模式",
            "blocked": [
                # 終端關鍵字（明確的指令格式才攔）
                (["ipconfig", "systeminfo", "tasklist", "netstat"],
                 "終端指令", "terminal", "⌨️ 終端模式"),
                # 教學關鍵字（只攔明確格式）
                (["記住：", "記住:"],
                 "教學指令", "teach", "📚 教學模式"),
                # 桌面控制（只攔明確操作指令）
                (["列出視窗", "滑鼠點擊", "鍵盤輸入", "開啟網頁 "],
                 "桌面控制指令", "desktop", "🖥 桌面模式"),
            ]
        },
        "terminal": {
            "desc": "終端模式",
            "blocked": [
                (["記住：", "記住:", "讀取 ", "學習 "],
                 "教學指令", "teach", "📚 教學模式"),
                (["截圖", "列出視窗", "滑鼠", "鍵盤", "視窗"],
                 "桌面控制指令", "desktop", "🖥 桌面模式"),
            ]
        },
        "dev": {
            "desc": "自主開發模式",
            "blocked": [
                (["記住：", "記住:", "讀取 ", "學習 "],
                 "教學指令", "teach", "📚 教學模式"),
                (["截圖", "列出視窗", "滑鼠", "鍵盤"],
                 "桌面控制指令", "desktop", "🖥 桌面模式"),
            ]
        },
        "teach": {
            "desc": "教學模式",
            "blocked": [
                (["dir ", "cd ", "python ", "git ", "pip "],
                 "終端指令", "terminal", "⌨️ 終端模式"),
                (["截圖", "列出視窗", "滑鼠", "鍵盤"],
                 "桌面控制指令", "desktop", "🖥 桌面模式"),
            ]
        },
        "desktop": {
            "desc": "桌面控制模式",
            "blocked": [
                (["記住：", "記住:", "讀取 ", "學習 "],
                 "教學指令", "teach", "📚 教學模式"),
                (["新增 ", "修改 ", "幫我改", ".py", "def "],
                 "程式開發需求", "dev", "🤖 自主開發模式"),
            ]
        },
    }

    def _check_mode_lock(self, text: str, mode: str) -> bool:
        """
        檢查輸入是否違反模式鎖定。
        第一層：比對寫死的關鍵字清單（快速）
        第二層：查記憶庫的模式觸發詞知識（動態）
        若違反 → 顯示提示並回傳 True。
        若正常 → 回傳 False。
        """
        rules       = self._MODE_LOCK_RULES.get(mode, {})
        blocked_list = rules.get("blocked", [])
        mode_desc   = rules.get("desc", mode)

        # ── 第一層：寫死關鍵字比對 ───────────────────────────────────────────
        for keywords, category, suggest_mode, suggest_label in blocked_list:
            if any(kw in text for kw in keywords):
                self._user_msg(text)
                self._agent_msg_no_ask(
                    f"我現在在「{mode_desc}」，只能處理{mode_desc}的事情。\n"
                    f"你輸入的內容像是「{category}」，請切換到 {suggest_label} 再試試。\n\n"
                    f"（點上方 {suggest_label} 按鈕即可切換）"
                )
                return True

        # ── 第二層：查記憶庫的模式觸發詞 ────────────────────────────────────
        # 只在對話模式做記憶庫查詢（避免其他模式誤判）
        if mode == "chat" and _memory:
            try:
                results = _memory.search(text, top_k=5)
                # 模式對應表：記憶庫關鍵詞 → (模式ID, 顯示標籤, 類別描述)
                mode_hint_map = {
                    "自主開發模式": ("dev",     "🤖 自主開發模式", "程式開發需求"),
                    "終端模式":     ("terminal","⌨️ 終端模式",    "終端指令"),
                    "教學模式":     ("teach",   "📚 教學模式",    "教學指令"),
                    "桌面控制模式": ("desktop", "🖥 桌面模式",    "桌面控制指令"),
                }
                for mem in results:
                    content = mem.get("content", "")
                    # 找記憶庫裡哪一筆包含「觸發詞」字眼且提到某個模式
                    if "觸發詞" not in content and "模式" not in content:
                        continue
                    for mode_name, (suggest_mode, suggest_label, category) in mode_hint_map.items():
                        if suggest_mode == mode:
                            continue  # 已經在這個模式，不需要提示
                        if mode_name in content:
                            # 再確認輸入的詞真的出現在這筆記憶的觸發詞裡
                            # 取觸發詞部分（冒號後面）
                            if "：" in content:
                                trigger_part = content.split("：", 1)[1]
                                trigger_words = [w.strip() for w in trigger_part.replace("、", ",").split(",")]
                                if any(tw and tw in text for tw in trigger_words):
                                    self._user_msg(text)
                                    self._agent_msg_no_ask(
                                        f"我現在在「{mode_desc}」，只能處理{mode_desc}的事情。\n"
                                        f"你輸入的內容像是「{category}」，請切換到 {suggest_label} 再試試。\n\n"
                                        f"（點上方 {suggest_label} 按鈕即可切換）"
                                    )
                                    return True
            except Exception:
                pass  # 記憶庫查詢失敗就跳過，不影響正常流程

        return False

    def send_text(self):
        text = self.input_box.text().strip()
        if not text or (self._worker and self._worker.isRunning()): return
        self.input_box.clear()
        mode = getattr(self, '_mode', 'chat')

        # ── 模式鎖定檢查（確認/取消/糾正指令跳過）──────────────────────────
        t_lower_lock = text.strip().lower()
        skip_lock = (
            t_lower_lock in ["確認", "好", "執行", "yes", "ok", "confirm",
                              "取消", "不", "算了", "cancel", "no"]
            or any(text.startswith(t) for t in ["不對", "錯了", "應該是", "正確答案是",
                                                 "不是這樣", "你說錯了", "答錯了", "正確的是", "其實是"])
        )
        if not skip_lock and self._check_mode_lock(text, mode):
            return

        # 教學模式：多種學習方式
        if mode == "teach":
            self._user_msg(f"[教學] {text}")

            # 功能 1：批次匯入腳本（輸入 py xxx.py）
            if text.strip().startswith("py ") and text.strip().endswith(".py"):
                self._run_worker(text)
                return

            # 功能 2：讀取檔案學習（輸入 讀取 xxx.txt 或 學習 xxx.pdf）
            import re as _re_teach
            file_match = _re_teach.search(r'(讀取|學習|read)\s+(.+\.\w+)', text)
            if file_match:
                filepath = file_match.group(2).strip()
                try:
                    import pathlib
                    f = pathlib.Path(filepath)
                    if not f.exists():
                        self._agent_msg(f"找不到檔案：{filepath}")
                        return

                    ext = f.suffix.lower()

                    # PDF 檔案
                    if ext == ".pdf":
                        try:
                            from pypdf import PdfReader
                            reader = PdfReader(str(f))
                            content = ""
                            for page in reader.pages:
                                page_text = page.extract_text()
                                if page_text:
                                    content += page_text + "\n"
                            if not content.strip():
                                self._agent_msg(f"PDF 無法提取文字（可能是掃描檔）：{f.name}")
                                return
                        except ImportError:
                            self._agent_msg("需要安裝 pypdf：pip install pypdf")
                            return
                    else:
                        # 純文字檔（txt, py, md, json 等）
                        content = f.read_text(encoding="utf-8", errors="ignore")

                    if not content.strip():
                        self._agent_msg(f"檔案內容為空：{f.name}")
                        return

                    # 智慧分段：按段落或換行拆，不是固定 200 字硬切
                    paragraphs = re.split(r'\n{2,}', content)  # 按空行分段
                    chunks = []
                    for para in paragraphs:
                        para = para.strip()
                        if len(para) < 10:
                            continue
                        # 太長的段落再拆
                        if len(para) > 300:
                            for i in range(0, len(para), 250):
                                sub = para[i:i+250].strip()
                                if len(sub) >= 10:
                                    chunks.append(sub)
                        else:
                            chunks.append(para)

                    count = 0
                    for chunk in chunks[:100]:  # 最多 100 條
                        if _memory:
                            _memory.store(chunk, tags=["file_learn", f.name], importance=6, source="file_learn")
                            count += 1

                    self._agent_msg(f"已從 {f.name} 學習 {count} 段知識（共 {len(content)} 字）")
                    self._refresh_memory()
                except Exception as e:
                    self._agent_msg(f"讀取失敗：{e}")
                return

            # 功能 3：一般知識輸入
            try:
                if _memory:
                    _memory.store(text, tags=["user_teach", "manual"], importance=8, source="teach_mode")
                    self._agent_msg(f"已記住：{text[:60]}{'...' if len(text)>60 else ''}")
                    self._refresh_memory()
                else:
                    self._agent_msg("記憶庫未載入")
            except Exception as e:
                self._agent_msg(f"儲存失敗：{e}")
            return

        # 全域確認/取消攔截（不管在哪個模式，有 pending 開發任務就攔截）
        t_lower = text.strip().lower()
        if t_lower in ["確認", "好", "執行", "yes", "ok", "confirm"]:
            try:
                from dev_tool import get_tool
                if get_tool().state.active:
                    self._user_msg("確認")
                    result = get_engine().confirm()
                    self._agent_msg(result)
                    return
            except Exception:
                pass
        if t_lower in ["取消", "不", "算了", "cancel", "no"]:
            try:
                from dev_tool import get_tool
                if get_tool().state.active:
                    self._user_msg("取消")
                    result = get_engine().cancel()
                    self._agent_msg(result)
                    return
            except Exception:
                pass

        # 對話模式的糾正偵測（任何模式都生效）
        correction_triggers = ["不對", "錯了", "應該是", "正確答案是", "不是這樣",
                               "你說錯了", "答錯了", "正確的是", "其實是"]
        is_correction = any(text.startswith(t) for t in correction_triggers)
        if is_correction and _memory:
            # 提取糾正內容
            correction = text
            for t in correction_triggers:
                if correction.startswith(t):
                    correction = correction[len(t):].strip("，, 。").strip()
                    break

            # 組合：問題 + 正確答案
            last_q = getattr(self, '_last_user_input', '')
            if last_q and correction:
                knowledge = f"{last_q} -> {correction}"
                _memory.store(knowledge, tags=["correction", "user_teach"], importance=9, source="correction")
                # 也單獨存糾正內容
                _memory.store(correction, tags=["correction", "user_teach"], importance=9, source="correction")
                self._user_msg(text)
                self._agent_msg(f"已學習糾正：{correction[:60]}")
                self._refresh_memory()
                return
            elif correction:
                _memory.store(correction, tags=["correction", "user_teach"], importance=9, source="correction")
                self._user_msg(text)
                self._agent_msg(f"已記住：{correction[:60]}")
                self._refresh_memory()
                return

        def _start(txt, m):
            w = AgentWorker(txt, self, mode=m)
            w.reply.connect(self._agent_msg)
            w.skip_memory_sig.connect(lambda skip: setattr(self, "_skip_next_memory", skip))
            w.claude_bar_sig.connect(self.show_claude_chat_bar)
            w.claude_reply_sig.connect(self._agent_msg_no_ask)
            w.log_line.connect(self._log)
            w.status_sig.connect(self._on_status)
            self._worker = w; w.start()

        # 桌面模式：直接執行
        if mode == "desktop":
            self._user_msg(f"[桌面] {text}")
            _start(text, "desktop")
            return

        # 改程式模式
        if mode == "dev":
            # 攔截確認/取消指令
            t_lower = text.strip().lower()
            if t_lower in ["確認", "好", "執行", "yes", "ok", "confirm"]:
                self._user_msg("確認")
                try:
                    from dev_tool import get_tool
                    if get_tool().state.active:
                        result = get_engine().confirm()
                        self._agent_msg(result)
                    else:
                        self._agent_msg("沒有待確認的行動")
                except Exception as e:
                    self._agent_msg(f"確認失敗：{e}")
                return
            if t_lower in ["取消", "不", "算了", "cancel", "no"]:
                self._user_msg("取消")
                try:
                    from dev_tool import get_tool
                    get_tool().handle_callback("dt_stop")
                    result = "❌ 已取消"
                    self._agent_msg(result)
                except Exception as e:
                    self._agent_msg(f"取消失敗：{e}")
                return

            self._user_msg(f"[改程式] {text}")
            # 優先用新的 dev_tool
            try:
                from dev_tool import get_tool
                tool = get_tool()

                # 繼續上次未完成的專案
                if any(kw in text for kw in ["繼續作業", "繼續上次", "繼續開發", "接著做", "繼續做", "我要繼續", "繼續專案"]):
                    if tool.state.request and tool.state.remaining_groups():
                        tool.state.active = True
                        tool.state.paused = False
                        tool.state.save()
                        done      = len(tool.state.completed_groups)
                        total     = len(tool.state.groups)
                        remaining = tool.state.remaining_groups()
                        import threading
                        threading.Thread(target=tool._push_mindmap, daemon=True).start()
                        self._agent_msg(
                            f"🔄 繼續上次的專案：{tool.state.request[:40]}\n"
                            f"已完成 {done}/{total} 個模組，剩餘 {len(remaining)} 個\n"
                            f"請在手機選擇要繼續哪個模組"
                        )
                    else:
                        self._agent_msg("目前沒有進行中的專案，請輸入新的需求開始開發。")
                    return

                import threading
                threading.Thread(
                    target=tool.start,
                    args=(text.strip(),),
                    daemon=True
                ).start()
                self._agent_msg("🤖 開始規劃，請稍候...")
            except Exception as e:
                self._agent_msg(f"❌ dev_tool 失敗：{e}")
            return

        # 終端模式
        if mode == "terminal":
            self._user_msg(f"[終端] {text}")
            _start(text, "terminal")
            return

        # 對話模式（預設）
        self._user_msg(text)
        _start(text, "chat")

    def voice_input(self):
        if not HAS_SR:
            self._agent_msg("❌ 請先安裝：pip install SpeechRecognition pyaudio"); return
        if self._voice_worker and self._voice_worker.isRunning(): return
        vw = VoiceWorker()

        def _on_recognized(t):
            if t:
                self._user_msg(f"🎤 {t}")
                self._run_worker(t)
            else:
                self._agent_msg("❌ 語音辨識失敗")

        def _on_voice_status(s):
            if s == "listening":
                self.voice_btn.setText("⏹")
                self._on_status("listening")
            else:
                self.voice_btn.setText("🎤")
                self._on_status("idle")

        vw.recognized.connect(_on_recognized)
        vw.status_sig.connect(_on_voice_status)
        self._voice_worker = vw; vw.start()

    def _on_confirm(self):
        """點確認按鈕 → 直接呼叫 dev_tool.confirm()，不走 AgentWorker"""
        if self._worker and self._worker.isRunning():
            return
        self.confirm_row.setVisible(False)
        self._user_msg("確認")
        try:
            from dev_tool import get_tool
            tool = get_tool()
            idx = tool.state.__dict__.get("current_step_idx", 0)
            tool.handle_callback(f"dt_confirm_{idx}")
        except Exception as e:
            self._agent_msg(f"確認失敗：{e}")

    def _on_cancel(self):
        """點取消按鈕 → 直接呼叫 dev_tool.cancel()，不走 AgentWorker"""
        if self._worker and self._worker.isRunning():
            return
        self.confirm_row.setVisible(False)
        self._user_msg("取消")
        try:
            from dev_tool import get_tool
            get_tool().handle_callback("dt_stop")
            self._agent_msg("❌ 已取消")
        except Exception as e:
            self._agent_msg(f"取消失敗：{e}")

    def _run_worker(self, text: str):
        """啟動 AgentWorker 執行指定文字（尊重目前模式）"""
        if self._worker and self._worker.isRunning():
            return
        mode = getattr(self, '_mode', 'chat')

        # 教學模式：直接存記憶庫，不走 Ollama
        if mode == "teach":
            try:
                if _memory:
                    _memory.store(text, tags=["user_teach", "manual"], importance=8, source="teach_mode")
                    self._agent_msg(f"已記住：{text[:60]}{'...' if len(text)>60 else ''}")
                    self._refresh_memory()
                else:
                    self._agent_msg("記憶庫未載入")
            except Exception as e:
                self._agent_msg(f"儲存失敗：{e}")
            return

        w = AgentWorker(text, self, mode=mode)
        w.reply.connect(self._agent_msg)
        w.log_line.connect(self._log)
        w.status_sig.connect(self._on_status)
        self._worker = w
        w.start()

    def _stop_worker(self):
        """取消正在執行的 worker"""
        if self._worker and self._worker.isRunning():
            self._worker.terminate()
            self._worker.wait(1000)
            self._worker = None
            self._agent_msg("（已取消）")
            self._on_status("idle")

    def _check_pending(self, ai_text: str):
        """判斷 AI 回覆是否包含待確認提示，顯示/隱藏確認列"""
        if "輸入「確認」執行" in ai_text or "✅ 輸入「確認」" in ai_text:
            self.confirm_row.setVisible(True)
        else:
            self.confirm_row.setVisible(False)

    def _on_status(self, s):
        text  = {"idle":"● idle","running":"● 思考中...","listening":"● 聆聽中...","error":"● 錯誤"}.get(s, s)
        color = {"idle":"#4ade80","running":"#fbbf24","listening":"#60a5fa","error":"#f87171"}.get(s,"#888")
        self.lbl_status.setText(text); self.lbl_status.setStyleSheet(f"color:{color};font-weight:600;")
        self.progress.setVisible(s == "running")
        self.send_btn.setVisible(s != "running")
        self.stop_btn.setVisible(s == "running")
        self.send_btn.setEnabled(s != "running")

    def _refresh_quick_actions(self, mode_id: str):
        """根據模式更新左側快速操作按鈕"""
        try:
            mode_actions = {
                "chat": [
                    ("🤖 問 Claude",  self._ask_claude_directly),
                    ("💬 問 ChatGPT", self._ask_chatgpt_directly),
                ],
                "terminal": [
                    ("⚡ 查看能力",    self._show_capabilities),
                    ("⌨️ 終端指令說明", self._show_terminal_help),
                    ("🔧 自動修復",    self._quick_repair),
                    ("🔍 分析模組",    self._analyze_module_dialog),
                ],
                "dev": [
                    ("🤝 與Claude共同開發", self._dev_with_claude),
                    ("🦾 立AI自己開發",     self._dev_solo),
                    ("💻 開發歷史",         self._show_dev_history),
                    ("🔧 自動修復",         self._quick_repair),
                ],
                "teach": [
                    ("➕ 新增知識",      self._show_learn_dialog),
                    ("🤖 問 Claude",   self._ask_claude_directly),
                    ("💬 問 ChatGPT",  self._ask_chatgpt_directly),
                ],
                "database": [
                    ("🧠 查看記憶庫",   lambda: self.tabs.setCurrentIndex(2)),
                    ("🎓 Claude知識庫", self._show_claude_knowledge),
                    ("💬 ChatGPT知識庫", self._show_chatgpt_knowledge),
                    ("📖 模組說明",     self._show_module_explain_dialog),
                ],
                "desktop": [
                    ("📸 截圖",       lambda: self._run_worker("截圖")),
                    ("🪟 列出視窗",   lambda: self._run_worker("列出視窗")),
                    ("📁 查看桌面",   lambda: self._run_worker("查看桌面資料夾")),
                    ("💻 系統資訊",   lambda: self._run_worker("系統資訊")),
                ],
            }

            actions = mode_actions.get(mode_id, mode_actions["chat"])

            # 移除舊按鈕
            for btn in self._quick_action_btns:
                self._quick_action_layout.removeWidget(btn)
                btn.hide()
                btn.deleteLater()
            self._quick_action_btns.clear()

            # 加入新按鈕
            for lbl, fn in actions:
                b = QPushButton(lbl)
                b.setObjectName("btn_accent")
                b.clicked.connect(fn)
                b.show()
                self._quick_action_layout.addWidget(b)
                self._quick_action_btns.append(b)

            # 強制重繪
            self._quick_action_layout.update()

            # 更新模式說明標籤顏色
            mode_colors = {
                "chat":     "#7F77DD",
                "terminal": "#185FA5",
                "dev":      "#0F6E56",
                "teach":    "#854F0B",
                "database": "#5B3A8A",
                "desktop":  "#993C1D",
            }
            color = mode_colors.get(mode_id, "#555")
            self._mode_label.setStyleSheet(f"color:{color};font-size:11px;font-weight:500;")
        except Exception as e:
            import logging as _log
            _log.getLogger("Agent.desktop").warning(f"[UI] _refresh_quick_actions 失敗：{e}")

    def _ask_claude_directly(self):
        """直接呼叫 chat_loop 與 Claude 多輪對話學習"""
        text = self.input_box.text().strip()
        if not text:
            self._agent_msg_no_ask("請先在輸入框輸入問題，再按「問 Claude」")
            return
        self.input_box.clear()
        self._user_msg(text)

        # 顯示進度條與停止列
        self.progress.setVisible(True)
        self.show_claude_chat_bar(True)
        self._agent_msg_no_ask("🔄 開始與 Claude 多輪對話學習，完成後通知你...")

        import threading

        def _run():
            try:
                from claude_desktop_bridge import get_bridge
                bridge = get_bridge()
                # 用 notify_fn 把每輪結果顯示在桌面
                def _notify(msg):
                    from PyQt6.QtCore import QTimer
                    QTimer.singleShot(0, lambda m=msg: self._agent_msg_no_ask(m))
                summary = bridge.chat_loop(
                    text,
                    max_rounds=9999,  # 無限輪，按停止按鈕才停
                    notify_fn=_notify,
                    ui_ref=self,
                )
            except Exception as e:
                summary = f"❌ Claude 學習失敗：{e}"

            from PyQt6.QtCore import QTimer
            QTimer.singleShot(0, lambda s=summary: self._on_claude_direct_reply(s))

        threading.Thread(target=_run, daemon=True).start()

    def _on_claude_direct_reply(self, answer: str):
        """Claude 學習完成後更新 UI"""
        self.progress.setVisible(False)
        self.show_claude_chat_bar(False)
        self._agent_msg_no_ask(answer)

    def show_chatgpt_chat_bar(self, show: bool = True):
        """顯示/隱藏 ChatGPT 對話循環控制列"""
        from PyQt6.QtCore import QTimer
        QTimer.singleShot(0, lambda: self.chatgpt_chat_row.setVisible(show))

    def _on_stop_chatgpt_chat(self):
        """停止 ChatGPT 對話循環"""
        try:
            from chatgpt_desktop_bridge import get_bridge
            get_bridge().stop_chat()
            self._agent_msg_no_ask("⏹ 已發送停止訊號，ChatGPT 對話將在這輪結束後停止")
        except Exception as e:
            self._agent_msg_no_ask(f"停止失敗：{e}")
        self.chatgpt_chat_row.setVisible(False)

    def _ask_chatgpt_directly(self):
        """直接呼叫 ChatGPTDesktopBridge 多輪學習（獨立執行緒）"""
        text = self.input_box.text().strip()
        if not text:
            self._agent_msg_no_ask("請先在輸入框輸入問題，再按「問 ChatGPT」")
            return
        self.input_box.clear()
        self._user_msg(text)

        self.progress.setVisible(True)
        self.show_chatgpt_chat_bar(True)
        self._agent_msg_no_ask("🔄 正在與 ChatGPT 對話學習，請稍候...")

        import threading
        from PyQt6.QtCore import QTimer

        def _notify(msg):
            QTimer.singleShot(0, lambda m=msg: self._agent_msg_no_ask(m))

        def _run():
            try:
                from chatgpt_desktop_bridge import get_bridge
                summary = get_bridge().chat_loop(
                    text, max_rounds=9999,
                    notify_fn=_notify, ui_ref=self,
                )
                QTimer.singleShot(0, lambda s=summary: self._on_chatgpt_done(s))
            except Exception as e:
                QTimer.singleShot(0, lambda: self._on_chatgpt_done(f"❌ ChatGPT 橋接失敗：{e}"))

        threading.Thread(target=_run, daemon=True).start()

    def _on_chatgpt_done(self, summary: str):
        """ChatGPT 多輪學習完成後更新 UI"""
        self.progress.setVisible(False)
        self.show_chatgpt_chat_bar(False)
        self._agent_msg_no_ask(summary)

    def _show_chatgpt_knowledge(self):
        """顯示 ChatGPT 知識庫統計"""
        try:
            from chatgpt_knowledge import get_knowledge
            stats = get_knowledge().get_stats()
            self._agent_msg_no_ask(stats)
            self.tabs.setCurrentIndex(0)
        except Exception as e:
            self._agent_msg_no_ask(f"ChatGPT 知識庫未載入：{e}")

    def _show_claude_knowledge(self):
        """顯示 Claude 知識庫統計和內容"""
        try:
            from claude_knowledge import get_knowledge
            kb = get_knowledge()
            stats = kb.get_stats()

            # 顯示各分類最新一筆
            details = []
            for cat in kb.get_all_categories():
                entries = kb.get_by_category(cat, limit=1)
                if entries:
                    e = entries[-1]
                    details.append("\n【" + cat + "】最新：" + e["question"][:40])

            msg = stats + "\n" + "".join(details) if details else stats
            self._agent_msg_no_ask(msg)
            self.tabs.setCurrentIndex(0)
        except Exception as e:
            self._agent_msg_no_ask(f"Claude 知識庫未載入：{e}")

    def _analyze_module_dialog(self):
        """彈出對話框輸入檔名，分析模組結構"""
        from PyQt6.QtWidgets import QInputDialog
        fname, ok = QInputDialog.getText(
            self, "🔍 分析模組",
            "輸入要分析的檔名（可多個，用空格分隔）：",
            text="telegram_bot.py"
        )
        if ok and fname.strip():
            self._run_worker("python analyze_module.py " + fname.strip())

    def _show_module_explain_dialog(self):
        """輸入 .py 檔名，用 AI 白話解釋這個模組的功能"""
        from PyQt6.QtWidgets import QInputDialog
        fname, ok = QInputDialog.getText(
            self, "📖 模組說明",
            "輸入要查詢的檔名（如：desktop_agent.py）：",
            text=""
        )
        if not ok or not fname.strip():
            return

        fname = fname.strip()
        if not fname.endswith(".py"):
            fname += ".py"

        def _explain():
            try:
                import pathlib
                fpath = pathlib.Path(fname)
                if not fpath.exists():
                    self._agent_msg_no_ask(f"找不到 {fname}")
                    return
                head = "\n".join(fpath.read_text(encoding="utf-8", errors="ignore").splitlines()[:80])
                prompt = (
                    f"以下是 Python 模組 {fname} 的前 80 行程式碼：\n\n"
                    f"{head}\n\n"
                    f"請用繁體中文，用 2-4 句話說明這個模組的功能和用途，"
                    f"像在跟不懂程式的人解釋一樣，簡單清楚。"
                )
                from ollama_guard import safe_infer
                result = safe_infer(prompt=prompt, model="qwen2.5:14b", timeout=60)
                self._agent_msg_no_ask(f"📖 {fname}\n\n{result}")
                self.tabs.setCurrentIndex(0)
            except Exception as e:
                self._agent_msg_no_ask(f"❌ 說明失敗：{e}")

        import threading
        threading.Thread(target=_explain, daemon=True).start()
        self._agent_msg_no_ask(f"正在分析 {fname}，請稍候...")
        self.tabs.setCurrentIndex(0)

