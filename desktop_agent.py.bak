        self._agent_msg(
            "終端模式使用方式：\n\n"
            "直接輸入指令：\n"
            "  dir -> 列出檔案\n"
            "  python xxx.py -> 執行 Python\n"
            "  git status -> Git 狀態\n"
            "  systeminfo -> 系統資訊\n"
            "  notepad -> 開啟記事本\n\n"
            "自然語言也可以：\n"
            "  查看系統資訊\n"
            "  執行 python test.py\n\n"
            "危險指令會先請您確認。"
        )
        self.tabs.setCurrentIndex(0)

    def _show_teach_help(self):
        self._agent_msg(
            "教學模式使用方式：\n\n"
            "1. 直接輸入知識 -> 存入記憶庫\n"
            "   例：Python list 用 append 新增元素\n\n"
            "2. 讀取 [檔案] -> 從檔案學習\n"
            "   例：讀取 notes.txt\n\n"
            "3. py batch_teach.py -> 批次匯入\n\n"
            "4. 在對話模式中糾正：\n"
            "   你問：X 是什麼？\n"
            "   立答：（錯誤回答）\n"
            "   你說：不對，X 是...\n"
            "   立學：已學習糾正！"
        )
        self.tabs.setCurrentIndex(0)

    def _show_batch_help(self):
        self._agent_msg(
            "批次匯入說明：\n\n"
            "  py batch_teach.py -> 匯入知識清單\n"
            "  py batch_teach_debug_fixes.py -> 匯入除錯經驗\n\n"
            "編輯 .py 檔案中的 KNOWLEDGE 清單來新增知識。"
        )
        self.tabs.setCurrentIndex(0)

    def _show_learn_dialog(self):
        """彈出學習輸入框，讓使用者輸入知識存入記憶庫"""
        from PyQt6.QtWidgets import QDialog, QVBoxLayout, QHBoxLayout, QLabel, QTextEdit, QPushButton, QComboBox
        dlg = QDialog(self)
        dlg.setWindowTitle("教立學習")
        dlg.setMinimumSize(500, 320)
        dlg.setStyleSheet(self.styleSheet())
        v = QVBoxLayout(dlg)
        v.setSpacing(10); v.setContentsMargins(16,16,16,16)

        v.addWidget(QLabel("輸入要讓立記住的知識："))
        text_edit = QTextEdit()
        text_edit.setPlaceholderText(
            "例如：\n"
            "Python 的 list comprehension 寫法是 [x for x in iterable if condition]\n"
            "我喜歡用深色主題的 UI\n"
            "公司名稱是 XXX，負責人是 OOO"
        )
        text_edit.setMinimumHeight(120)
        v.addWidget(text_edit)

        # 重要性選擇
        row = QHBoxLayout()
        row.addWidget(QLabel("重要性："))
        importance = QComboBox()
        for label in ["1 - 一般", "3 - 普通", "5 - 重要", "7 - 很重要", "9 - 必須記住"]:
            importance.addItem(label)
        importance.setCurrentIndex(2)  # 預設重要性 5
        row.addWidget(importance); row.addStretch()
        v.addLayout(row)

        # 標籤
        tag_row = QHBoxLayout()
        tag_row.addWidget(QLabel("標籤（逗號分隔）："))
        from PyQt6.QtWidgets import QLineEdit
        tag_input = QLineEdit()
        tag_input.setPlaceholderText("例如：python, 程式設計, 工作")
        tag_row.addWidget(tag_input)
        v.addLayout(tag_row)

        # 按鈕
        btn_row = QHBoxLayout()
        btn_save = QPushButton("存入記憶庫")
        btn_save.setStyleSheet("background:#065f46;color:#6ee7b7;border-radius:8px;padding:8px 16px;")
        btn_cancel = QPushButton("取消")
        btn_cancel.setObjectName("btn_dim")
        btn_row.addStretch(); btn_row.addWidget(btn_save); btn_row.addWidget(btn_cancel)
        v.addLayout(btn_row)

        def _save():
            content = text_edit.toPlainText().strip()
            if not content:
                return
            imp = int(importance.currentText().split(" - ")[0])
            tags = [t.strip() for t in tag_input.text().split(",") if t.strip()] or ["manual"]
            if _memory:
                _memory.store(content, tags=tags, importance=imp, source="user_teach")
                self._refresh_memory()
                self._agent_msg(f"✅ 已記住：{content[:60]}{'...' if len(content)>60 else ''}")
                self.tabs.setCurrentIndex(0)
                dlg.accept()
            else:
                self._agent_msg("⚠️ 記憶庫未載入，無法儲存")
                dlg.reject()

        btn_save.clicked.connect(_save)
        btn_cancel.clicked.connect(dlg.reject)
        dlg.exec()

