    def _show_dev_history(self):
        if _USE_DEV:
            history = get_dev_engine().get_history(10)
            self._agent_msg(f"最近開發記錄：\n{history}")
            self.tabs.setCurrentIndex(0)
        else:
            self._agent_msg("dev_tool 未載入")

    def _quick_repair(self):
        if _scheduler:
            task = create_auto_repair_task(".")
            tid = _scheduler.submit(task)
            self._agent_msg(f"✓ 修復任務已提交（ID: {tid}）")
            self._refresh_tasks()
        else:
            self._agent_msg("⚠️ 排程器未啟動，請確認 task_scheduler.py 已放入專案資料夾")

    def _add_memory(self):
        c = self.mem_input.text().strip()
        if c and _memory:
            _memory.store(c, tags=["manual"], importance=7)
            self.mem_input.clear(); self._refresh_memory()

    def _delete_selected_memory(self):
        item = self.mem_list.currentItem()
        if not item:
            self._agent_msg("請先選取一筆記憶再刪除")
            return
        # 從顯示文字取得 ID（格式：[id:xxxx] 內容...）
        text = item.text()
        import re
        m = re.search(r'\[id:(\w+)\]', text)
        if m and _memory:
            mem_id = m.group(1)
            if _memory.forget(mem_id):
                self._refresh_memory()
                self._log(f"[{self._ts()}] [記憶] 已刪除 ID：{mem_id}")
            else:
                self._agent_msg("刪除失敗，找不到此記憶")
        else:
            self._agent_msg("無法解析記憶 ID，請重新整理後再試")

    # ── 資料刷新 ─────────────────────────────────────────────────────────────

    def _refresh_memory(self):
        if not _memory: return
        q = self.mem_search.text().strip()
        items = _memory.search(q, top_k=30) if q else sorted(_memory._memories, key=lambda m: m["accessed_at"], reverse=True)[:40]
        self.mem_list.clear()
        for m in items:
            stars = "★" * min(m.get("importance",5),5)
            tags  = "  ".join(f"[{t}]" for t in m.get("tags",[]))
            mem_id = m.get("id","?")
            item  = QListWidgetItem(f"{stars}  {m['content'][:80]}\n{tags}  [id:{mem_id}]")
            item.setForeground(QColor("#d0d0d0")); self.mem_list.addItem(item)
        self._set_stat(self.stat_mem, str(len(_memory._memories)))

    def _refresh_tasks(self):
        if not hasattr(self, 'task_list'):
            return
        self.task_list.clear()
        if not _scheduler: self.task_list.addItem(QListWidgetItem("（排程器未啟動）")); return
        tasks = _scheduler.list_tasks()
        if not tasks: self.task_list.addItem(QListWidgetItem("（無任務）")); return
        for t in tasks:
            icon  = {"done":"✓","failed":"✗","running":"▶","pending":"○","cancelled":"✕"}.get(t["status"],"?")
            color = {"done":"#4ade80","failed":"#f87171","running":"#fbbf24"}.get(t["status"],"#888")
            item  = QListWidgetItem(f"{icon}  [{t['id']}] {t['name']}  {t['progress']}")
            item.setForeground(QColor(color)); self.task_list.addItem(item)
        self._set_stat(self.stat_task, str(len(tasks)))

    def _load_log(self):
        lf = pathlib.Path("logs") / f"agent_{datetime.datetime.now().strftime('%Y%m%d')}.log"
        if lf.exists():
            self.log_box.setPlainText("\n".join(lf.read_text(encoding="utf-8",errors="ignore").splitlines()[-200:]))
            self.log_box.moveCursor(QTextCursor.MoveOperation.End)
        else:
            self.log_box.append("（找不到今天的日誌檔）")

    # ── 計時器 ───────────────────────────────────────────────────────────────

    def _start_timers(self):
        t1 = QTimer(self); t1.timeout.connect(self._tick); t1.start(1000)
        t2 = QTimer(self); t2.timeout.connect(self._refresh_tasks); t2.start(5000)
        t3 = QTimer(self); t3.timeout.connect(self._poll_mobile_queue); t3.start(1500)
        t4 = QTimer(self); t4.timeout.connect(self._check_mobile_msgs); t4.start(2000)
        t5 = QTimer(self); t5.timeout.connect(self._poll_learn_folder); t5.start(3000)
        t6 = QTimer(self); t6.timeout.connect(self._auto_backup_memory); t6.start(600000)  # 每 10 分鐘備份
        t7 = QTimer(self); t7.timeout.connect(self._update_log_status); t7.start(300000)  # 每 5 分鐘更新 Ollama 狀態
        t8 = QTimer(self); t8.timeout.connect(self._check_nodes_bg); t8.start(30000)      # 每 30 秒檢查 AB 節點
        # 啟動時立刻更新一次
        QTimer.singleShot(1000, self._update_log_status)
        QTimer.singleShot(2000, self._check_nodes_bg)
        # 啟動時清空舊的 queue
        try:
            import pathlib as _pl, json as _json
            qf = _pl.Path("memory/mobile_queue.json")
            if qf.exists():
                qf.write_text("[]", encoding="utf-8")
        except Exception:
            pass
        self._last_queue_count = 0
        # 建立學習資料夾
        self._learn_folder = pathlib.Path("learn_inbox")
        self._learn_folder.mkdir(exist_ok=True)
        self._learned_files = set()
        self._pending_learn = {}  # {filename: 偵測時間} 等待 10 分鐘猶豫期
        try:
            for f in self._learn_folder.iterdir():
                if f.is_file():
                    self._learned_files.add(f.name)
        except Exception:
            pass
        # 啟動時備份一次
        self._auto_backup_memory()

    def _auto_backup_memory(self):
        """自動備份記憶庫"""
        try:
            import shutil
            src = pathlib.Path("memory/long_term_memory.json")
            if not src.exists():
                return
            backup_dir = pathlib.Path("memory/backups")
            backup_dir.mkdir(exist_ok=True)
            ts = datetime.datetime.now().strftime("%Y%m%d_%H%M")
            dst = backup_dir / f"memory_backup_{ts}.json"
            existing = sorted(backup_dir.glob("memory_backup_*.json"))
            if len(existing) >= 10:
                for old in existing[:-9]:
                    old.unlink()
            shutil.copy2(src, dst)
        except Exception:
            pass

    def _poll_learn_folder(self):
        """每 3 秒掃描 learn_inbox，新檔案等 10 分鐘猶豫期後才學習"""
        try:
            if not self._learn_folder.exists():
                return

            now = datetime.datetime.now()

            for f in self._learn_folder.iterdir():
                if not f.is_file():
                    continue
                if f.name in self._learned_files:
                    continue
                if f.name.startswith("."):
                    continue

                ext = f.suffix.lower()
                if ext not in [".txt", ".md", ".py", ".json", ".csv", ".pdf"]:
                    continue

                # 第一次偵測到 → 加入等待清單，通知使用者
                if f.name not in self._pending_learn:
                    self._pending_learn[f.name] = now
                    remaining = 10
                    self._agent_msg(f"偵測到新檔案：{f.name}\n{remaining} 分鐘後自動學習（刪除檔案可取消）")
                    continue

                # 已在等待 → 檢查是否已過 10 分鐘
                detected_time = self._pending_learn[f.name]
                elapsed = (now - detected_time).total_seconds()
                if elapsed < 600:  # 10 分鐘 = 600 秒
                    continue

                # 10 分鐘到了，檔案還在 → 開始學習
                del self._pending_learn[f.name]
                self._learned_files.add(f.name)
                self._learn_file(f)

            # 檢查等待中的檔案是否被刪除了
            removed = []
            for fname in self._pending_learn:
                if not (self._learn_folder / fname).exists():
                    removed.append(fname)
                    self._agent_msg(f"已取消學習：{fname}（檔案已刪除）")
            for fname in removed:
                del self._pending_learn[fname]

        except Exception:
            pass

    def _learn_file(self, f):
        """讀取檔案內容並存入記憶庫"""
        try:
            ext = f.suffix.lower()

            if ext == ".pdf":
                try:
                    from pypdf import PdfReader
                    reader = PdfReader(str(f))
                    content = ""
                    for page in reader.pages:
                        page_text = page.extract_text()
                        if page_text:
                            content += page_text + "\n"
                    if not content.strip():
                        self._agent_msg(f"learn_inbox: PDF 無法提取文字 ({f.name})")
                        return
                except ImportError:
                    self._agent_msg(f"learn_inbox: 需要 pip install pypdf")
                    return
            else:
                content = f.read_text(encoding="utf-8", errors="ignore")

            if not content.strip():
                return

            import re as _re_learn
            paragraphs = _re_learn.split(r'\n{2,}', content)
            count = 0
            for para in paragraphs:
                para = para.strip()
                if len(para) < 10:
                    continue
                if len(para) > 300:
                    for i in range(0, len(para), 250):
                        sub = para[i:i+250].strip()
                        if len(sub) >= 10 and _memory:
                            _memory.store(sub, tags=["auto_learn", f.name], importance=6, source="learn_inbox")
                            count += 1
                else:
                    if _memory:
                        _memory.store(para, tags=["auto_learn", f.name], importance=6, source="learn_inbox")
                        count += 1

            self._agent_msg(f"已自動學習：{f.name}（{count} 段，{len(content)} 字）")
            self._log(f"[{self._ts()}] [系統] learn_inbox: {f.name} -> {count} 段知識")
            self._refresh_memory()

            # 推送通知到手機
            try:
                import bot_config, telebot, threading
                def _notify():
                    try:
                        bot = telebot.TeleBot(bot_config.TELEGRAM_TOKEN, parse_mode=None)
                        msg = f"立 AI 已學習新知識\n\n檔案：{f.name}\n內容：{count} 段（{len(content)} 字）"
                        for cid in bot_config.ALLOWED_CHAT_IDS:
                            bot.send_message(cid, msg)
                    except Exception:
                        pass
                threading.Thread(target=_notify, daemon=True).start()
            except Exception:
                pass

        except Exception as e:
            self._agent_msg(f"learn_inbox: 讀取 {f.name} 失敗 ({e})")

    def _poll_mobile_queue(self):
        """每 1.5 秒讀取手機訊息 queue，有新訊息就顯示在日誌"""
        try:
            import json, pathlib
            queue_file = pathlib.Path("memory/mobile_queue.json")
            if not queue_file.exists():
                return
            queue = json.loads(queue_file.read_text(encoding="utf-8"))
            if len(queue) <= self._last_queue_count:
                return
            new_msgs = queue[self._last_queue_count:]
            self._last_queue_count = len(queue)
            for msg in new_msgs:
                # 只寫入日誌，不打擾主對話
                self._log(f"[{msg['time']}] [手機] {msg['user'][:60]}")
                self._log(f"[{msg['time']}] [回覆] {msg['ai'][:100]}")
        except Exception:
            pass

    def _check_mobile_msgs(self):
        """每 2 秒檢查有沒有新的手機訊息，有就顯示在桌面視窗"""
        try:
            if not _MOBILE_MSG_FILE.exists():
                return
            msgs = _json.loads(_MOBILE_MSG_FILE.read_text(encoding="utf-8"))
            if len(msgs) <= self._last_mobile_count:
                return
            # 有新訊息
            new_msgs = msgs[self._last_mobile_count:]
            self._last_mobile_count = len(msgs)
            for m in new_msgs:
                self._show_mobile_msg(m["user"], m["reply"])
        except Exception:
            pass

    def _tick(self):
        # 更新執行狀態指示
        try:
            if self._worker and self._worker.isRunning():
                dots = "." * (int(datetime.datetime.now().second) % 4)
                if hasattr(self, "lbl_uptime_status"):
                    elapsed = datetime.datetime.now() - self._start_time
                    h, m = divmod(int(elapsed.total_seconds()), 3600)
                    m, s = divmod(m, 60)
                    self.lbl_uptime_status.setText(f"執行中{dots}")
            else:
                if hasattr(self, "lbl_uptime_status"):
                    elapsed = datetime.datetime.now() - self._start_time
                    h, m = divmod(int(elapsed.total_seconds()), 3600)
                    m, s = divmod(m, 60)
                    self.lbl_uptime_status.setText(f"{h:02d}:{m:02d}:{s:02d}")
        except Exception:
            pass

        self.lbl_clock.setText(datetime.datetime.now().strftime("%H:%M:%S"))
        e = int((datetime.datetime.now() - self._start_time).total_seconds())
        h,r = divmod(e,3600); m,s = divmod(r,60)
        self._set_stat(self.stat_uptime, (f"{h}h " if h else "")+f"{m}m {s}s")

    # ── 顯示輔助 ─────────────────────────────────────────────────────────────

    def _show_mobile_msg(self, user_text: str, ai_reply: str):
        """顯示手機傳來的對話（只寫入日誌，不打擾主對話）"""
        self._log(f"[{self._ts()}] [手機] {user_text[:60]}")
        self._log(f"[{self._ts()}] [回覆] {ai_reply[:100]}")

    def _user_msg(self, text):
        self._last_user_input = text  # 記住最後一次輸入（糾正用）
        self.chat_history.append(
            f'<div style="text-align:left;margin:4px 0;">'
            f'<span style="background:#1e3a5f;color:#93c5fd;border-radius:10px;padding:6px 12px;display:inline-block;">You: {text}</span>'
            f'<div style="color:#555;font-size:11px;">{self._ts()}</div></div>')
        self.chat_history.moveCursor(QTextCursor.MoveOperation.End)

    def _agent_msg(self, text, skip_memory: bool = False):
        self._last_ai_reply = text  # 記住最後一次回覆（糾正用）
        self.chat_history.append(
            f'<div style="text-align:left;margin:4px 0;">'
            f'<span style="background:#1e2d1e;color:#86efac;border-radius:10px;padding:6px 12px;display:inline-block;">Li: {text}</span>'
            f'<div style="color:#555;font-size:11px;">{self._ts()}</div></div>')
        self.chat_history.moveCursor(QTextCursor.MoveOperation.End)
        self._check_pending(text)

        # 對話模式下，每次 AI 回覆後問要不要存入記憶
        mode = getattr(self, '_mode', 'chat')
        last_input = getattr(self, '_last_user_input', '')
        skip = skip_memory or getattr(self, "_skip_next_memory", False)
        self._skip_next_memory = False
        if skip:
            return  # Claude 橋接的回答不問存入
        if mode == "chat" and last_input and "[LLM ERROR]" not in text and not text.startswith("（已取消）"):
            # 檢查是否已經在記憶裡（已學過就不用再問）
            already_known = False
            if _lobster:
                # 查 reflex memory
                cached = _lobster.reflex_memory.get(last_input)
                if cached:
                    already_known = True
                # 查 episodic memory
                if not already_known:
                    recent = _lobster.episodic.search_recent(20)
                    for ep in recent:
                        if ep.get("input", "").strip() == last_input.strip():
                            already_known = True
                            break

            if not already_known:
                self._pending_memory = {
                    "input": last_input,
                    "reply": text,
                }
                self.memory_row.setVisible(True)

    # ── Claude 對話循環控制 ──────────────────────────────────────────────────

    def show_claude_chat_bar(self, show: bool = True):
        """顯示/隱藏 Claude 對話循環控制列"""
        from PyQt6.QtCore import QTimer
        QTimer.singleShot(0, lambda: self.claude_chat_row.setVisible(show))

    def _on_stop_claude_chat(self):
        """停止 Claude 對話循環"""
        try:
            from claude_desktop_bridge import get_bridge
            get_bridge()._stop_chat = True
            self._agent_msg_no_ask("⏹ 已發送停止訊號，對話將在這輪結束後停止")
        except Exception as e:
            self._agent_msg_no_ask(f"停止失敗：{e}")
        self.claude_chat_row.setVisible(False)

    def _on_mem_save(self):
        """使用者同意存入記憶庫"""
        pm = getattr(self, '_pending_memory', None)
        if pm and _lobster:
            # 存入 episodic memory
            _lobster.episodic.store(pm["input"], pm["reply"])
            # 存入 reflex memory
            _lobster.reflex_memory.learn(pm["input"], pm["reply"])
            self._agent_msg_no_ask("(已存入記憶)")
        self._pending_memory = None
        self.memory_row.setVisible(False)

    def _on_mem_skip(self):
        """使用者跳過，不存入記憶"""
        self._pending_memory = None
        self.memory_row.setVisible(False)

    def _agent_msg_no_ask(self, text):
        """顯示訊息但不觸發記憶確認"""
        self.chat_history.append(
            f'<div style="text-align:left;margin:4px 0;">'
            f'<span style="background:#1e2d1e;color:#86efac;border-radius:10px;padding:6px 12px;display:inline-block;">Li: {text}</span>'
            f'<div style="color:#555;font-size:11px;">{self._ts()}</div></div>')
        self.chat_history.moveCursor(QTextCursor.MoveOperation.End)

    def _log(self, line: str):
        # 攔截 Ollama 狀態更新訊號
        if line.startswith("__ollama_status__"):
            online = line == "__ollama_status__online"
            self._set_ollama_status(online)
            return

        # 攔截 AB 節點狀態訊號
        if line.startswith("__node_status__"):
            try:
                parts = line[len("__node_status__"):].split("|")
                local_ok, remote_ok, lat_str, dist_str = parts
                if hasattr(self, "lbl_node_a"):
                    self.lbl_node_a.setText(local_ok)
                if hasattr(self, "lbl_node_b"):
                    self.lbl_node_b.setText(remote_ok + (f" {lat_str}" if lat_str else ""))
                if hasattr(self, "stat_node_a"):
                    vl = self.stat_node_a.findChild(QLabel, "val")
                    if vl: vl.setText(local_ok)
                if hasattr(self, "stat_node_b"):
                    vl = self.stat_node_b.findChild(QLabel, "val")
                    if vl: vl.setText(remote_ok + (f" {lat_str}" if lat_str else ""))
                if hasattr(self, "stat_node_dist"):
                    vl = self.stat_node_dist.findChild(QLabel, "val")
                    if vl: vl.setText(dist_str)
            except Exception:
                pass
            return

        ts = self._ts()
        color = "#86efac"  # 預設綠色

        # ── agent_logger 等級（WARNING / ERROR / INFO / DEBUG）────────────────
        if " ERROR " in line or line.startswith("[") and "] ERROR " in line:
            color = "#f87171"   # 紅色
            source = "錯誤"
        elif " WARNING " in line:
            color = "#fbbf24"   # 黃色
            source = "警告"
        elif " INFO " in line:
            color = "#86efac"   # 綠色
            source = "系統"
        # ── 原有標記 ────────────────────────────────────────────────────────
        elif "[手機]" in line:
            color = "#38bdf8"   # 藍色
            source = "手機"
        elif "[輸入]" in line:
            color = "#93c5fd"
            source = "電腦"
        elif "[回覆]" in line:
            color = "#86efac"
            source = "AI"
        elif "[系統]" in line:
            color = "#a78bfa"   # 紫色
            source = "系統"
        else:
            source = ""

        source_html = f'<span style="color:#555;font-size:11px;">[{source}]</span> ' if source else ""
        import re as _re
        if _re.match(r"^\[\d{2}:\d{2}:\d{2}\]", line):
            html = (
                f'{source_html}'
                f'<span style="color:{color};">{line}</span>'
            )
        else:
            html = (
                f'<span style="color:#333;">[{ts}]</span> '
                f'{source_html}'
                f'<span style="color:{color};">{line}</span>'
            )
        self.log_box.append(html)
        self.log_box.moveCursor(QTextCursor.MoveOperation.End)
        # 同步更新完整日誌快取（供篩選還原用）
        self._full_log_html = self.log_box.toHtml()

    def _sec(self, text):
        l = QLabel(text.upper()); l.setStyleSheet("color:#555;font-size:10px;font-weight:700;letter-spacing:1px;"); return l

    def _stat_row(self, label, value):
        w = QWidget(); h = QHBoxLayout(w); h.setContentsMargins(0,0,0,0)
        lb = QLabel(label); lb.setStyleSheet("color:#888;font-size:12px;")
        vl = QLabel(value); vl.setStyleSheet("color:#7eb8f7;font-weight:700;"); vl.setObjectName("val")
        h.addWidget(lb); h.addStretch(); h.addWidget(vl); return w

    def _set_stat(self, widget, value):
        vl = widget.findChild(QLabel, "val")
        if vl: vl.setText(value)

    def _ts(self): return datetime.datetime.now().strftime("%H:%M:%S")


if __name__ == '__main__':
    app = QApplication(sys.argv)
    app.setApplicationName("立 AI 系統核心")
    win = LobsterDesktop()
    win.show()
    sys.exit(app.exec())
