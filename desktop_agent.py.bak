                # 存到模組層級讓 dev_tool 能取得
                import desktop_agent as _da_self
                _da_self._bot_instance = bot

                def is_ok(m):
                    return not allowed or m.chat.id in allowed

                def _mode_keyboard():
                    """建立模式選擇的 inline keyboard（第一層）"""
